@page
@model BSSLTaskManagement.Pages.Menu.ClientFormsAllocationModel
@{
    ViewData["Title"] = "Client Forms Allocation";
}
<form id="clientFormsAllocationForm" method="post">
    @Html.AntiForgeryToken()

    <main class="app-main">

        <div class="app-content-header" style="padding:10px;">
            <div class="container-fluid">
                <!--begin::Row-->
                <div class="row">
                    <div class="col-sm-6">
                        <h3 class="mb-0">Client Forms Allocation</h3>
                    </div>
                    <div class="col-sm-6">
                        <ol class="breadcrumb float-sm-end">
                            <li class="breadcrumb-item" style="padding:5px;"><a href="#">Home</a></li>
                            <li class="breadcrumb-item active" aria-current="page" style="padding:5px;">Client Forms Allocation</li>
                        </ol>
                    </div>
                </div>
                <!--end::Row-->
            </div>
        </div>

        <div class="card card-primary card-outline mb-4">
            <!--begin::Header-->
            <div class="app-content">
                <!--begin::Container-->
                <div class="container-fluid">
                    <!--end::Header-->
                    <!--begin::Form-->
                    <div class="row">
                        <div class="col-md-12">
                            <!--begin::Body-->
                            <div class="card-body">
                                <h6 class="spn font-italic"></h6>
                                @if (TempData["Success"] != null)
                                {
                                    <div class="container">
                                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                                            @TempData["Success"]
                                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                                        </div>
                                    </div>
                                }
                                @if (TempData["Error"] != null)
                                {
                                    <div class="container">
                                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                            @TempData["Error"]
                                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                                        </div>
                                    </div>
                                }

                                <!-- top SAVE button — mirrors the footer button so users don't have to scroll -->
                                <!-- type="button": JS validates + confirms, then clicks the real (hidden) submit button below -->
                                <div class="mt-3 mb-2">
                                    <button type="button" class="btn btn-success text-light" id="saveBtn-top" disabled>Save</button>
                                </div>

                                <!-- ROW 1: The 3 dropdowns -->
                                <div class="row row2">

                                    <!-- DROPDOWN 1: Client — loaded on page load. name binds straight to AllocationForm.EntityCode -->
                                    <div class="col-sm-4">
                                        <label for="clientId" class="form-label req">Client</label>
                                        <select name="AllocationForm.EntityCode" class="form-control form-select border-primary" id="clientId">
                                            <option value="">--Select Client--</option>
                                            @foreach (var item in Model.ClientList)
                                            {
                                                <option value="@item.Value">@item.Text</option>
                                            }
                                        </select>
                                    </div>

                                    <!-- DROPDOWN 2: Subsystem — loaded on page load. name binds straight to AllocationForm.SubSystemCode -->
                                    <div class="col-sm-4">
                                        <label for="subsystemId" class="form-label req">Subsystem</label>
                                        <select name="AllocationForm.SubSystemCode" class="form-control form-select border-primary" id="subsystemId">
                                            <option value="">--Select Subsystem--</option>
                                            @foreach (var item in Model.SubsystemList)
                                            {
                                                <option value="@item.Value">@item.Text</option>
                                            }
                                        </select>
                                    </div>

                                    <!-- DROPDOWN 3: Module — AJAX populated once Subsystem is selected. -->
                                    <!-- The visible select carries the ModuleSetup Id (needed to fetch the sub-menu list); -->
                                    <!-- the hidden field carries the ModuleCode string that SaveClientFormsAllocation actually needs. -->
                                    <div class="col-sm-4">
                                        <label for="moduleId" class="form-label req">Module</label>
                                        <select class="form-control form-select border-primary" id="moduleId" disabled>
                                            <option value="">--Select Module--</option>
                                        </select>
                                        <input type="hidden" name="AllocationForm.ModuleCode" id="moduleCodeHidden" />
                                    </div>
                                </div>

                                <!-- SUB-MENU ALLOCATION TABLE — populated once all 3 dropdowns are selected -->
                                <div class="row row2 mt-4" id="subMenuTableWrapper" style="display:none;">
                                    <div class="col-sm-12">
                                        <table class="table table-bordered display nowrap" id="subMenuTable" style="width:100%">
                                            <thead class="table-light">
                                                <tr>
                                                    <th style="text-align:center;padding:10px; border:1px solid lightgrey; text-transform:none; width:80px;">SN</th>
                                                    <th style="text-align:left;padding:10px; border:1px solid lightgrey; text-transform:none;">Sub Menus</th>
                                                    <th style="text-align:center;padding:10px; border:1px solid lightgrey; text-transform:none; width:120px;">
                                                        Active
                                                        <input type="checkbox" class="form-check-input ms-2" id="selectAllSubMenus" title="Check/uncheck all" />
                                                    </th>
                                                </tr>
                                            </thead>
                                            <tbody id="subMenuTableBody">
                                                <!-- Rows injected by JS, each with real name="AllocationForm.SubMenus[i]..." fields -->
                                            </tbody>
                                        </table>
                                    </div>
                                </div>

                                <div id="noSubMenusMsg" class="alert alert-info" style="display:none;">
                                    No sub-menus found for the selected Subsystem / Module.
                                </div>

                                <!-- footer BUTTON -->
                                <div class="mt-3" style="margin-bottom:2%">
                                    <button type="button" class="btn btn-success text-light" id="saveBtn-bottom" disabled>Save</button>
                                </div>

                                <!-- The real submit button. Hidden from view — JS clicks it after validation/confirmation -->
                                <!-- passes, which triggers a genuine form POST straight to OnPostAsync. -->
                                <button type="submit" id="submitBtn" style="display:none;" aria-hidden="true" tabindex="-1"></button>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>
</form>
@section Scripts {
    <script>
        // ═══════════════════════════════════════════════════════════════════════════
        // ELEMENTS
        // ═══════════════════════════════════════════════════════════════════════════

        const clientSelect      = document.getElementById('clientId');
        const subsystemSelect   = document.getElementById('subsystemId');
        const moduleSelect      = document.getElementById('moduleId');
        const moduleCodeHidden  = document.getElementById('moduleCodeHidden');
        const tableWrapper      = document.getElementById('subMenuTableWrapper');
        const tableBody         = document.getElementById('subMenuTableBody');
        const noSubMenusMsg     = document.getElementById('noSubMenusMsg');
        const saveButtons       = document.querySelectorAll('#saveBtn-top, #saveBtn-bottom');
        const selectAllCheckbox = document.getElementById('selectAllSubMenus');
        const submitBtn         = document.getElementById('submitBtn');

        function setSaveButtonsDisabled(disabled) {
            saveButtons.forEach(btn => btn.disabled = disabled);
        }

        // ═══════════════════════════════════════════════════════════════════════════
        // HELPERS
        // ═══════════════════════════════════════════════════════════════════════════

        function resetDropdown(selectEl, placeholder) {
            selectEl.innerHTML = `<option value="">${placeholder}</option>`;
            selectEl.disabled  = true;
        }

        function clearSubMenuTable() {
            tableBody.innerHTML = '';
            tableWrapper.style.display  = 'none';
            noSubMenusMsg.style.display = 'none';
            setSaveButtonsDisabled(true);
            selectAllCheckbox.checked = false;
        }

        function refreshSelectAllState() {
            const boxes = Array.from(document.querySelectorAll('.subMenuActive'));
            selectAllCheckbox.checked = boxes.length > 0 && boxes.every(cb => cb.checked);
        }

        // ═══════════════════════════════════════════════════════════════════════════
        // CASCADE: Subsystem → Module
        // ═══════════════════════════════════════════════════════════════════════════

        subsystemSelect.addEventListener('change', async function () {
            const subsystemCode = this.value;
            resetDropdown(moduleSelect, "--Select Module--");
            moduleCodeHidden.value = '';
            clearSubMenuTable();
            if (!subsystemCode) return;

            try {
                const res  = await fetch(`?handler=ModulesBySubsystem&subsystemCode=${encodeURIComponent(subsystemCode)}`);
                const data = await res.json();

                moduleSelect.innerHTML = '<option value="">--Select Module--</option>';
                data.forEach(item => {
                    const opt = document.createElement('option');
                    opt.value = item.value;
                    opt.textContent = item.text;
                    opt.setAttribute('data-code', item.code ?? '');
                    moduleSelect.appendChild(opt);
                });
                moduleSelect.disabled = false;
            } catch (err) {
                Swal.fire({ icon: 'error', title: 'Error', text: 'Failed to load modules.' });
                console.error(err);
            }
        });

        moduleSelect.addEventListener('change', function () {
            const opt = moduleSelect.options[moduleSelect.selectedIndex];
            moduleCodeHidden.value = opt ? (opt.getAttribute('data-code') || '') : '';
        });

        // ═══════════════════════════════════════════════════════════════════════════
        // TRIGGERS FOR RE-LOADING THE SUB-MENU TABLE
        // ═══════════════════════════════════════════════════════════════════════════

        clientSelect.addEventListener('change', maybeLoadSubMenus);
        moduleSelect.addEventListener('change', maybeLoadSubMenus);

        async function maybeLoadSubMenus() {
            const clientCode    = clientSelect.value;
            const subsystemCode = subsystemSelect.value;
            const moduleId      = moduleSelect.value;

            if (!clientCode || !subsystemCode || !moduleId) {
                clearSubMenuTable();
                return;
            }

            Swal.fire({ title: 'Loading...', text: 'Fetching sub-menus, please wait.', allowOutsideClick: false, didOpen: () => Swal.showLoading() });

            try {
                const res  = await fetch(`?handler=SubMenus&subsystemCode=${encodeURIComponent(subsystemCode)}&moduleId=${moduleId}&clientCode=${encodeURIComponent(clientCode)}`);
                const data = await res.json();

                tableBody.innerHTML = '';

                if (!data || data.length === 0) {
                    tableWrapper.style.display  = 'none';
                    noSubMenusMsg.style.display = 'block';
                    setSaveButtonsDisabled(true);
                    Swal.close();
                    return;
                }

                data.forEach((item, index) => {
                    const tr = document.createElement('tr');
                    tr.innerHTML = `
                        <td style="text-align:center;padding:10px; border:1px solid lightgrey;">${index + 1}</td>
                        <td style="text-align:left;padding:10px; border:1px solid lightgrey;">
                            ${item.subMenuName ?? ''}
                            <input type="hidden" name="AllocationForm.SubMenus[${index}].SubMenuId" value="${item.subMenuId}" />
                        </td>
                        <td style="text-align:center;padding:10px; border:1px solid lightgrey;">
                            <input type="checkbox" class="form-check-input subMenuActive" name="AllocationForm.SubMenus[${index}].IsActive" value="true" ${item.isActive ? 'checked' : ''} />
                        </td>`;
                    tableBody.appendChild(tr);
                });

                tableWrapper.style.display  = 'block';
                noSubMenusMsg.style.display = 'none';
                setSaveButtonsDisabled(false);
                refreshSelectAllState();
                Swal.close();

            } catch (err) {
                Swal.close();
                Swal.fire({ icon: 'error', title: 'Error', text: 'Failed to load sub-menus.' });
                console.error(err);
            }
        }

        // ═══════════════════════════════════════════════════════════════════════════
        // SELECT ALL / UNSELECT ALL — purely client-side convenience, not bound/posted
        // ═══════════════════════════════════════════════════════════════════════════

        selectAllCheckbox.addEventListener('change', function () {
            const checked = this.checked;
            document.querySelectorAll('.subMenuActive').forEach(cb => cb.checked = checked);
        });

        tableBody.addEventListener('change', function (e) {
            if (e.target.classList.contains('subMenuActive')) {
                refreshSelectAllState();
            }
        });

        // ═══════════════════════════════════════════════════════════════════════════
        // SAVE — validate + confirm, then trigger the real (hidden) submit button.
        // The actual save is still a genuine form POST to OnPostAsync (model-bound,
        // no fetch/JSON) — this just gives us a validation + confirmation step first.
        // ═══════════════════════════════════════════════════════════════════════════

        saveButtons.forEach(btn => btn.addEventListener('click', async function () {
            if (!clientSelect.value) {
                Swal.fire({ icon: 'warning', title: 'Validation', text: 'Please select a Client.' });
                return;
            }
            if (!subsystemSelect.value) {
                Swal.fire({ icon: 'warning', title: 'Validation', text: 'Please select a Subsystem.' });
                return;
            }
            if (!moduleSelect.value) {
                Swal.fire({ icon: 'warning', title: 'Validation', text: 'Please select a Module.' });
                return;
            }
            if (document.querySelectorAll('.subMenuActive').length === 0) {
                Swal.fire({ icon: 'warning', title: 'Validation', text: 'No sub-menus to save for this selection.' });
                return;
            }

            const confirm = await Swal.fire({
                icon: 'question',
                title: 'Save Allocation',
                text: 'Are you sure you want to save this allocation?',
                showCancelButton: true,
                confirmButtonText: 'Yes, Save',
                cancelButtonText: 'Cancel',
                confirmButtonColor: '#198754',
                cancelButtonColor: '#6c757d'
            });

            if (!confirm.isConfirmed) return;

            submitBtn.click();
        }));
    </script>
}
