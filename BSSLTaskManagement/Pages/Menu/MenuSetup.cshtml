@page
@model BSSLTaskManagement.Pages.Menu.MenuSetupModel
@{
    ViewData["Title"] = "Menu";
}

<div class="card card-primary card-outline mb-4">
    <!--begin::Header-->
    <div class="card-header">
        <div class="card-title">Menu</div>
    </div>
    <!--end::Header-->
    <!--begin::Form-->
    <form>
        <!--begin::Body-->

        <div class="card-body">
        <div class="row">
            <div class="mb-3 col-4">
                <label for="inputSystemTypeName" class="form-label">System Type Name</label>
                <select class="form-control" id="inputSystemTypeName">
                    <option value="">--Select--</option>
                        @foreach (var item in Model.SystemTypeList)
                        {
                            <option value="@item.Value">@item.Text</option>
                        }
                </select>
            </div>

                <div class="mb-3 col-4">
                    <label for="inputModuleName" class="form-label">Module Name:</label>
                    <select class="form-control" id="inputModuleName">
                        <option value="">--Select--</option>
                    </select>
                </div>

                <div class="mb-3 col-4">
                    <label for="inputMainMenu" class="form-label">Main-Menu</label>
                    <select class="form-control" id="inputMainMenu">
                        <option value="">--Select--</option>
                    </select>
                </div>

        </div>
        </div>
        <!--end::Body-->
        <!--begin::Footer-->
        <div class="card-footer">
            <button type="button" class="btn btn-success">Save</button>
            <button type="button" onclick="AddDropdownRow()" class="btn btn-primary">Add New Row</button>
            <button type="reset" class="btn btn-warning">Refresh</button>
        </div>

        <!--end::Footer-->
    </form>
    <!--end::Form-->
</div>

    <!--begin::Table-->
<div class="card card-outline mb-4">
                        <table class="table table-bordered display" id="MenuSetupTable">
                            <thead>
                                <tr>
                                    <th style="text-align:center;padding:10px;border:1px solid lightgrey;text-transform:none;">S/N</th>
                                    <th style="text-align:center;padding:10px;border:1px solid lightgrey;text-transform:none;">Menu Code</th>
                                    <th style="text-align:center;padding:10px;border:1px solid lightgrey;text-transform:none;">Menu Name</th>
                                    <th style="text-align:center;padding:10px;border:1px solid lightgrey;text-transform:none;">Order No.</th>
                                    <th style="text-align:center;padding:10px;border:1px solid lightgrey;text-transform:none;">Action</th>
                                </tr>
                            </thead>
                            <tbody id="tableBody">
                                <tr id="0" role="row">
                                    <td style="padding:10px; border:1px solid lightgrey; width:20px;">1</td>

                                    <td class="col-1" style="text-align:left;padding:10px;border:1px solid lightgrey;">
                                        <input style="width:350px" type="text" class="form-control border-primary menuCode" />
                                    </td>

                                    <td class="col-1" style="text-align:left;padding:10px;border:1px solid lightgrey;">
                                        <input style="width:350px" type="text" class="form-control border-primary menuName" />
                                    </td>

                                     <td class="col-1" style="text-align:center;padding:10px;border:1px solid lightgrey;">
                                      <input style="width:100px" type="text" class="form-control border-primary orderNumber" />
                                    </td>

                                    <td style="text-align:center;padding:10px;border:1px solid lightgrey;">
                                        @* <button type="button" class="btn btn-primary btn-sm">
                                            <i class="fa fa-edit"></i> Edit
                                        </button> *@
                                           <button type="button" class="btn btn-danger btn-sm removeRow">
                                            <i class="fa fa-trash"></i> Delete
                                        </button>
                                    </td>
                                </tr>
                            </tbody>    
                        </table>

    <!-- Hidden template row — cloned when Add New Row is clicked -->
    <table style="display:none">
        <tr id="rowTemplate" style="display:none">
            <td style="padding:10px;border:1px solid lightgrey; width:20px; " class="sn"></td>

            <td class="col-1" style="text-align:left;padding:10px;border:1px solid lightgrey;">
                <input style="width:350px" type="text" class="form-control border-primary menuCode" />
            </td>

            <td class="col-1" style="text-align:left;padding:10px;border:1px solid lightgrey;">
                <input style="width:350px" type="text" class="form-control border-primary menuName" />
            </td>

            <td class="col-1" style="text-align:center;padding:10px;border:1px solid lightgrey;">
                <input style="width:100px" type="text" class="form-control border-primary orderNumber" />
            </td>

            <td style="text-align:center;padding:10px;border:1px solid lightgrey;">
                @* <button type="button" class="btn btn-primary btn-sm">
                    <i class="fa fa-edit"></i> Edit
                </button> *@
                <button type="button" class="btn btn-danger btn-sm removeRow">
                    <i class="fa fa-trash"></i> Delete
                </button>
            </td>
        </tr>       
    </table>
   </div>


<div class="card-footer">
    <button type="button" class="btn btn-success">Save</button>
    <button type="button" onclick="AddDropdownRow()" class="btn btn-primary">Add New Row</button>
    <button type="button" class="btn btn-warning">Refresh</button>
    
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>

        // ─── INITIALIZE DATATABLE ──────────────────────────────────────
        let table = $('#MenuSetupTable').DataTable({
            paging: true,
            pageLength: 10,
            ordering: false,       // preserve manual row order
            searching: false,      // optional — remove if you want search
            info: true,
            columnDefs: [
                { orderable: false, targets: '_all' }
            ]
        });


        // ─── ADD NEW ROW ───────────────────────────────────────────────
        function AddDropdownRow() {

            // Count existing rows before adding
            let rowCount = table.rows().count();

            // Clone the hidden template row, strip its id to avoid duplicates
            let newRow = $("#rowTemplate").clone().removeAttr("id");

            // Make the cloned row visible
            newRow.show();

            // Set the S/N serial number
            newRow.find(".sn").text(rowCount + 1);

            // Clear any leftover input values from the template
            newRow.find("input").val("");

            // Add row to DataTables and redraw without jumping to page 1
            table.row.add(newRow[0]).draw(false);   // ← note: pass newRow[0] (DOM node), not the jQuery object

            // Jump to the page that contains the new row
            let pageLength  = table.page.len();
            let newRowIndex = table.rows().count() - 1;
            let newPage     = Math.floor(newRowIndex / pageLength);
            table.page(newPage).draw(false);

            table.columns.adjust().responsive.recalc();
        }


        // ─── REMOVE ROW ────────────────────────────────────────────────
        $(document).on('click', '.removeRow', function () {

            table.row($(this).closest('tr')).remove().draw(false);

            ReIndexRows();

            table.columns.adjust().responsive.recalc();
        });


        // ─── RE-INDEX ROWS ──────────────────────────────────────────────
        function ReIndexRows() {
            table.rows().every(function (rowIdx) {
                let row = $(this.node());           // ← wrap in $() for jQuery methods

                $(row).attr("id", rowIdx);
                $(row).find("td:first").text(rowIdx + 1);
            });
        }

    </script>
}