@page
@model BSSLTaskManagement.Pages.Menu.MenuSetupModel
@{
    ViewData["Title"] = "Menu";
}

<div class="card card-primary card-outline mb-4">
    <!--begin::Header-->
    <div class="card-header">
        <div class="card-title">Menu</div>
    </div>
    <!--end::Header-->
    <!--begin::Form-->
    <form>
        <!--begin::Body-->
        <div class="card-body">
            <div class="mb-3 col-6">
                <label for="inputSystemTypeName" class="form-label">System Type Name</label>
                <select class="form-control" id="inputSystemTypeName">
                    <option value="">--Select--</option>
                </select>
            </div>

            <div class="row">
                <div class="mb-3 col-6">
                    <label for="inputModuleName" class="form-label">Module Name:</label>
                    <select class="form-control" id="inputModuleName">
                        <option value="">--Select--</option>
                    </select>
                </div>

                <div class="mb-3 col-6">
                    <label for="inputMainMenu" class="form-label">Main-Menu</label>
                    <select class="form-control" id="inputMainMenu">
                        <option value="">--Select--</option>
                    </select>
                </div>

                <div class="mb-3 col-6">
                    <label for="inputMenuName" class="form-label">Menu Name</label>
                    <input type="text" class="form-control" id="inputMenuName">
                </div>

                <div class="mb-3 col-2">
                    <label for="inputOrderNumber" class="form-label">Order Number</label>
                    <input type="number" class="form-control" id="inputOrderNumber" min="1">
                </div>

                <div class="mb-3 col-6">
                    <label for="inputIconImageName" class="form-label">Icon Image Name</label>
                    <input type="text" class="form-control" id="inputIconImageName">
                </div>

                <div class="mb-3 col-3">
                    <label for="inputUploadImageIcon" class="form-label">Upload Image Icon</label>
                    <input type="file" class="form-control" id="inputUploadImageIcon">
                </div>

            </div>
        </div>
        <!--end::Body-->
        <!--begin::Footer-->
        <div class="card-footer">
            <button type="button" class="btn btn-warning">Cancel Record</button>
            <button type="button" class="btn btn-success">Save</button>
        </div>

        <!--end::Footer-->
    </form>
    <!--end::Form-->
</div>

    <!--begin::Table-->
<div class="card card-outline mb-4">
                        <table class="table table-bordered display" id="MenuSetupTable">
                            <thead>
                                <tr>
                                    <th style="text-align:center;padding:10px;border:1px solid lightgrey;text-transform:none;">S/N</th>
                                    <th style="text-align:center;padding:10px;border:1px solid lightgrey;text-transform:none;">Module Name</th>
                                    <th style="text-align:center;padding:10px;border:1px solid lightgrey;text-transform:none;">Main Menu</th>
                                    <th style="text-align:center;padding:10px;border:1px solid lightgrey;text-transform:none;">Name</th>
                                    <th style="text-align:center;padding:10px;border:1px solid lightgrey;text-transform:none;">Order No.</th>
                                    <th style="text-align:center;padding:10px;border:1px solid lightgrey;text-transform:none;">Action</th>
                                </tr>
                            </thead>
                            <tbody id="tableBody">
                                <tr id="0" role="row">
                                    <td style=padding:10px;border:1px; width:20px ; solid lightgrey;">1</td>

                                    <td class="col-1" style="text-align:left;padding:10px;border:1px solid lightgrey;">
                                        <input style="width:350px" type="text" class="form-control border-primary moduleName" />
                                    </td>

                                    <td class="col-1" style="text-align:left;padding:10px;border:1px solid lightgrey;">
                                        <input style="width:250px" type="text" class="form-control border-primary mainMenu" />
                                    </td>

                                    <td class="col-1" style="text-align:left;padding:10px;border:1px solid lightgrey;">
                                        <input style="width:250px" type="text" class="form-control border-primary name" />
                                    </td>

                                    <td class="col-1" style="text-align:center;padding:10px;border:1px solid lightgrey;">
                                        <input style="width:70px" type="text" class="form-control border-primary orderNumber" />
                                    </td>

                                    <td style="text-align:center;padding:10px;border:1px solid lightgrey;">
                                        <button type="button" class="btn btn-primary btn-sm">
                                            <i class="fa fa-edit"></i> Edit
                                        </button>
                                        <button type="button" class="btn btn-danger btn-sm">
                                            <i class="fa fa-trash"></i> Delete
                                        </button>
                                    </td>
                                </tr>
                            </tbody>    
                        </table>

    <!-- Hidden template row — cloned when Add New Row is clicked -->
    <table style="display:none">
        <tr id="rowTemplate" style="display:none">
            <td style=padding:10px;border:1px; width:20px ; solid lightgrey;" class="sn"></td>

            <td class="col-1" style="text-align:left;padding:10px;border:1px solid lightgrey;">
                <input style="width:350px" type="text" class="form-control border-primary moduleName" />
            </td>

            <td class="col-1" style="text-align:left;padding:10px;border:1px solid lightgrey;">
                <input style="width:250px" type="text" class="form-control border-primary mainMenu" />
            </td>

            <td class="col-1" style="text-align:left;padding:10px;border:1px solid lightgrey;">
                <input style="width:250px" type="text" class="form-control border-primary name" />
            </td>

            <td class="col-1" style="text-align:center;padding:10px;border:1px solid lightgrey;">
                <input style="width:70px" type="text" class="form-control border-primary orderNumber" />
            </td>

            <td style="text-align:center;padding:10px;border:1px solid lightgrey;">
                <button type="button" class="btn btn-primary btn-sm">
                    <i class="fa fa-edit"></i> Edit
                </button>
                <button type="button" class="btn btn-danger btn-sm">
                    <i class="fa fa-trash"></i> Delete
                </button>
            </td>
        </tr>
    </table>


<div class="card-footer">
    <button type="button" onclick="AddDropdownRow()" class="btn btn-primary">Add New Row</button>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>

// ─── ADD NEW ROW ───────────────────────────────────────────────
function AddDropdownRow() {

// Count how many rows exist before adding
let rowCount = table.rows().count();

// Clone the hidden template row and remove its id so there's no duplicate
let newRow = $("#rowTemplate").clone().removeAttr("id");

// Make the cloned row visible
newRow.show();

// Set the S/No. serial number for the new row
newRow.find(".sn").text(rowCount + 1);

// Clear all input values in the new row (template may have leftover data)
newRow.find("input").val("");

// Add the new row to DataTables (not just the DOM) and redraw
// draw(false) = redraw without jumping back to page 1
table.row.add(newRow).draw(false);

// ── Jump to the page that contains the newly added row ──
let pageLength  = table.page.len();              // rows per page (10)
let newRowIndex = table.rows().count() - 1;      // index of the last (new) row
let newPage     = Math.floor(newRowIndex / pageLength); // which page it's on

table.page(newPage).draw(false); // navigate to that page

// Recalculate column widths for responsive layout
table.columns.adjust().responsive.recalc();
}


// ─── REMOVE ROW ────────────────────────────────────────────────
// Delegated click — works on both existing rows and newly added ones
$(document).on('click', '.removeRow', function () {

// Remove the row from DataTables (not just the DOM)
// draw(false) = stay on current page, don't jump to page 1
table.row($(this).closest('tr')).remove().draw(false);

// Re-number all S/No. values so they stay sequential after deletion
ReIndexRows();

table.columns.adjust().responsive.recalc();
});


// ─── RE-INDEX ROWS ──────────────────────────────────────────────
// After a row is removed, loop through all rows and fix their serial numbers
function ReIndexRows() {
table.rows().every(function (rowIdx) {
let row = this.node();

// Update the row's id attribute to match its new position
$(row).attr("id", rowIdx);

// Update the S/No. cell (first td) to show the correct number
$(row).find("td:first").text(rowIdx + 1);
});
}


    </script>
}