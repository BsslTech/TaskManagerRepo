@page
@model BSSLTaskManagement.Pages.Menu.DefinedDropdownModel
@{
}
<div class="container mt-4">
    <div class="col-md-12">
        <div class="card card-primary card-outline mb-4">
            <div class="card-header">
                <div class="card-title">System Defined Menu Setup</div>
            </div>
            <form>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <label for="SystemMenu" class="form-label">System Menu</label>
                            <select class="form-select" id="SystemMenu">
                                <option selected>-Select-</option>
                            </select>
                        </div>
                        <div class="col-sm-6">
                            <label for="SystemSubMenu" class="form-label">System Sub-Menu</label>
                            <select class="form-select" id="SystemSubMenu">
                                <option selected>-Select-</option>
                            </select>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="app-content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-12">
                <div class="card mb-12">
                    <div class="card-body">
                        <div style="margin-bottom:2%">
                            <button type="button" class="btn btn-success" onclick="submitTable()">Submit</button>
                            <button type="button" onclick="AddDropdownRow()" class="btn btn-primary">Add New Row</button>
                            <button type="button" class="btn btn-warning">Cancel</button>
                        </div>

                        <table class="table table-bordered display nowrap" id="dropdownDataTable" style="width:100%">
                            <thead>
                                <tr>
                                    <th style="text-align:center;padding:10px;border:1px solid lightgrey;text-transform:none;">S/No.</th>
                                    <th style="text-align:center;padding:10px;border:1px solid lightgrey;text-transform:none;">Dropdown Code</th>
                                    <th style="text-align:center;padding:10px;border:1px solid lightgrey;text-transform:none;">Dropdown Name</th>
                                    <th style="text-align:center;padding:10px;border:1px solid lightgrey;text-transform:none;">Order Number</th>
                                    <th style="text-align:center;padding:10px;border:1px solid lightgrey;text-transform:none;">Related to</th>
                                    <th style="text-align:center;padding:10px;border:1px solid lightgrey;text-transform:none;">Action</th>
                                </tr>
                            </thead>
                            <tbody id="tableBody">
                                <tr id="0" role="row">
                                    <td style="text-align:left;padding:10px;border:1px solid lightgrey;">1</td>
                                    <td style="text-align:left;padding:10px;border:1px solid lightgrey;">
                                        <input style="width:100px" type="text" class="form-control border-primary dropdownCode" />
                                    </td>
                                    <td style="text-align:left;padding:10px;border:1px solid lightgrey;">
                                        <input style="width:250px" type="text" class="form-control border-primary dropdownName" />
                                    </td>
                                    <td style="text-align:left;padding:10px;border:1px solid lightgrey;">
                                        <input style="width:100px" type="text" class="form-control border-primary orderNumber" />
                                    </td>
                                    <td style="text-align:left;padding:10px;border:1px solid lightgrey;">
                                        <select class="form-select border-primary relatedTo">
                                            <option>--Select--</option>
                                        </select>
                                    </td>
                                    <td style="text-align:center;padding:10px;border:1px solid lightgrey;">
                                        <button type="button" class="btn btn-danger removeRow">
                                            <i class="fa fa-trash"></i> Remove
                                        </button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <!-- Hidden template row — cloned when Add New Row is clicked -->
                        <table style="display:none">
                            <tr id="rowTemplate" style="display:none">
                                <td style="text-align:left;padding:10px;border:1px solid lightgrey;" class="sn"></td>
                                <td style="text-align:left;padding:10px;border:1px solid lightgrey;">
                                    <input style="width:100px" type="text" class="form-control border-primary dropdownCode" />
                                </td>
                                <td style="text-align:left;padding:10px;border:1px solid lightgrey;">
                                    <input style="width:250px" type="text" class="form-control border-primary dropdownName" />
                                </td>
                                <td style="text-align:left;padding:10px;border:1px solid lightgrey;">
                                    <input style="width:100px" type="text" class="form-control border-primary orderNumber" />
                                </td>
                                <td style="text-align:left;padding:10px;border:1px solid lightgrey;">
                                    <select class="form-select border-primary relatedTo">
                                        <option>--Select--</option>
                                    </select>
                                </td>
                                <td style="text-align:center;padding:10px;border:1px solid lightgrey;">
                                    <button type="button" class="btn btn-danger removeRow">
                                        <i class="fa fa-trash"></i> Remove
                                    </button>
                                </td>
                            </tr>
                        </table>

                        <div class="card-footer" style="margin-top:1%">
                            <button type="button" class="btn btn-success" onclick="submitTable()">Submit</button>
                            <button type="button" onclick="AddDropdownRow()" class="btn btn-primary">Add New Row</button>
                            <button type="button" class="btn btn-warning">Cancel</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>



