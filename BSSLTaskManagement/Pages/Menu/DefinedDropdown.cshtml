@page
@model BSSLTaskManagement.Pages.Menu.DefinedDropdownModel
@{
}
<div class="container mt-4">
    <div class="col-md-12">
        <div class="card card-primary card-outline mb-4">
            <!--begin::Header-->
            <div class="card-header">
                <div class="card-title">System Defined Menu Setup</div>
            </div>
            <!--end::Header-->
            <!--begin::Form-->
            <form>
                <!--begin::Body-->
                <div class="card-body">
                    <div class="row g-3  ">
                        <div class="col-sm-6">
                            <label for="clientName" class="form-label">System Menu</label>
                            <select class="form-select" id="Licensetype">
                                <option selected>-Select-</option>

                            </select>
                        </div>
                        <div class="col-sm-6">
                            <label for="clientName" class="form-label">System Sub-Menu</label>
                            <select class="form-select" id="Licensetype">
                                <option selected>-Select-</option>

                            </select>
                        </div>
                    </div>
                </div>
            </form>
            <!--end::Form-->
        </div>
    </div>

</div>

<div class="container mt-4">


    <div class="card-body p-0">
        <table class="table table-bordered mb-0 text-center align-middle">
            <thead>
                <tr>
                    <th class="py-3">S/No.</th>
                    <th class="py-3">Dropdown Code</th>
                    <th class="py-3">Dropdown Name</th>
                    <th class="py-3">Order Number</th>
                    <th class="py-3">Related to</th>
                    <th class="py-3">Action</th>
                </tr>
            </thead>
            <tbody id="tableBody">
                <tr>
                    <td class="py-3">1</td>
                    <td class="py-3"><input type="text" class="form-control" value="3" /></td>
                    <td class="py-3"><input type="text" class="form-control" value="IFRS" /></td>
                    <td class="py-3"><input type="text" class="form-control" /></td>
                    <td class="py-3">
                        <select class="form-select">
                            <option>--Select--</option>
                        </select>
                    </td>
                    <td class="py-3"><button type="button" class="btn btn-danger" onclick="removeRow(this)">Remove</button></td>
                </tr>
                <tr>
                    <td class="py-3">2</td>
                    <td class="py-3"><input type="text" class="form-control" value="2" /></td>
                    <td class="py-3"><input type="text" class="form-control" value="IPSAS" /></td>
                    <td class="py-3"><input type="text" class="form-control" /></td>
                    <td class="py-3">
                        <select class="form-select">
                            <option>--Select--</option>
                        </select>
                    </td>
                    <td class="py-3"><button type="button" class="btn btn-danger" onclick="removeRow(this)">Remove</button></td>
                </tr>
                <tr>
                    <td class="py-3">3</td>
                    <td class="py-3"><input type="text" class="form-control" value="1" /></td>
                    <td class="py-3"><input type="text" class="form-control" value="GAAP" /></td>
                    <td class="py-3"><input type="text" class="form-control" /></td>
                    <td class="py-3">
                        <select class="form-select">
                            <option>--Select--</option>
                        </select>
                    </td>
                    <td class="py-3"><button type="button" class="btn btn-danger" onclick="removeRow(this)">Remove</button></td>
                </tr>
            </tbody>
        </table>
    </div>

    <!-- Action Buttons -->
    <div class="mt-3 d-flex gap-2">
        <button type="button" class="btn btn-success" onclick="submitTable()">Submit</button>
        <button type="button" class="btn btn-success" onclick="addNewRow()">Add New Row</button>
        <button type="button" class="btn btn-danger">Cancel</button>
    </div>
</div>


    <script>
        let rowCount = 3;

        function addNewRow() {
            rowCount++;
            const tbody = document.getElementById('tableBody');
            const newRow = `
                <tr>
                    <td class="py-3">${rowCount}</td>
                    <td class="py-3"><input type="text" class="form-control" /></td>
                    <td class="py-3"><input type="text" class="form-control" /></td>
                    <td class="py-3"><input type="text" class="form-control" /></td>
                    <td class="py-3">
                        <select class="form-select">
                            <option>--Select--</option>
                        </select>
                    </td>
                    <td class="py-3"><button type="button" class="btn btn-danger" onclick="removeRow(this)">Remove</button></td>
                </tr>`;
            tbody.insertAdjacentHTML('beforeend', newRow);
        }

        function removeRow(btn) {
            const row = btn.closest('tr');
            row.remove();
            document.querySelectorAll('#tableBody tr').forEach((tr, i) => {
                tr.querySelector('td:first-child').textContent = i + 1;
            });
            rowCount = document.querySelectorAll('#tableBody tr').length;
        }

        function submitTable() {
            alert('Table submitted!');
        }
    </script>
