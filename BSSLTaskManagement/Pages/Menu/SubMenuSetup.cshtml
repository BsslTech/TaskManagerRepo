@page
@model BSSLTaskManagement.Pages.Menu.SubMenuSetupModel
@{
}
<form id="subMenuForm" method="post">
    @Html.AntiForgeryToken()

    <main class="app-main">

        <div class="app-content-header" style="padding:10px;">
            <div class="container-fluid">
                <!--begin::Row-->
                <div class="row">
                    <div class="col-sm-6">
                        <h3 class="mb-0">Sub-Menu Setup</h3>
                    </div>
                    <div class="col-sm-6">
                        <ol class="breadcrumb float-sm-end">
                            <li class="breadcrumb-item" style="padding:5px;"><a href="#">Home</a></li>
                            <li class="breadcrumb-item active" aria-current="page" style="padding:5px;">Sub-Menu Setup</li>
                        </ol>
                    </div>
                </div>
                <!--end::Row-->
            </div>
        </div>

        <div class="card card-primary card-outline mb-4">
            <!--begin::Header-->
            <div class="app-content">
                <!--begin::Container-->
                <div class="container-fluid">
                    <!--end::Header-->
                    <!--begin::Form-->
                    <div class="row">
                        <div class="col-md-12">
                            <!--begin::Body-->
                            <div class="card-body">
                                <h6 class="spn font-italic"></h6>
                                @if (TempData["Success"] != null)
                                {
                                    <div class="container">
                                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                                            @TempData["Success"]
                                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                                        </div>
                                    </div>
                                }
                                @if (TempData["Error"] != null)
                                {
                                    <div class="container">
                                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                            @TempData["Error"]
                                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                                        </div>
                                    </div>
                                }


                                

                                <!--end::Header-->
                                <!-- ═══════════════════════════════════════════════════════════════ -->
                                <!-- FORM SECTION — shown by default, hidden when View List is open -->
                                <!-- ═══════════════════════════════════════════════════════════════ -->
                                <div id="formSection">
                                    <div class="mt-3 mb-2">
                                        <button type="button" class="btn btn-success text-light" id="saveBtn-top">Save</button>
                                        <button type="button" class="btn btn-warning" id="refreshBtn-top">Refresh</button>
                                        <button type="button" class="btn btn-primary" id="viewListBtn-top">View List</button>
                                    </div>
                                    <!-- Hidden fields — dropdowns write into these on change -->
                                    <input type="hidden" asp-for="SubMenuForm.Id" id="hiddenId" />
                                    <input type="hidden" asp-for="SubMenuForm.SystemId" id="systemTypeHidden" />
                                    <input type="hidden" asp-for="SubMenuForm.ModuleSetupId" id="moduleHidden" />
                                    <input type="hidden" asp-for="SubMenuForm.MainMenuId" id="mainMenuHidden" />
                                    <input type="hidden" asp-for="SubMenuForm.MenuId" id="menuHidden" />


                                    <!-- ROW 1: The 4 cascade dropdowns -->
                                    <div class="row row2">

                                        <!-- DROPDOWN 1: System Type — loaded on page load -->
                                        <div class="col-sm-4">
                                            <label for="systemTypeId" class="form-label req">System Type Name</label>
                                            <select class="form-control form-select border-primary" id="systemTypeId">
                                                <option value="">--Select System Type--</option>
                                                @foreach (var item in Model.SystemTypeList)
                                                {
                                                    <option value="@item.Value">@item.Text</option>
                                                }
                                            </select>
                                        </div>

                                        <!-- DROPDOWN 2: Module Name — AJAX populated -->
                                        <div class="col-sm-4">
                                            <label for="moduleName" class="form-label req">Module Name</label>
                                            <select class="form-control form-select border-primary" id="moduleName" disabled>
                                                <option value="">--Select Module Name--</option>
                                            </select>
                                        </div>

                                        <!-- DROPDOWN 3: Main Menu Name — AJAX populated -->
                                        <div class="col-sm-4">
                                            <label for="mainMenuName" class="form-label req">Main Menu Name</label>
                                            <select class="form-control form-select border-primary" id="mainMenuName" disabled>
                                                <option value="">--Select Main Menu--</option>
                                            </select>
                                        </div>
                                    </div>

                                    <!-- ROW 2: SubMenu Code, SubMenu Name, Form Header -->
                                    <div class="row row2">
                                        <!-- DROPDOWN 4: Menu Name — AJAX populated -->
                                        <div class="col-sm-4">
                                            <label for="menuName" class="form-label req">Menu Name</label>
                                            <select class="form-control form-select border-primary" id="menuName" disabled>
                                                <option value="">--Select Menu Name--</option>
                                            </select>
                                        </div>
                                        <div class="col-sm-4">
                                            <label class="form-label req">SubMenu Code / FormID</label>
                                            <input type="text" class="form-control border-primary" asp-for="SubMenuForm.SubMenuCode" />
                                        </div>
                                        <div class="col-sm-4">
                                            <label class="form-label req">SubMenu Name</label>
                                            <input type="text" class="form-control border-primary" asp-for="SubMenuForm.SubMenuName" />
                                        </div>                                      
                                    </div>


                                    <!-- ROW 3: Page URL, Report Page URL, Icon Image Name -->
                                    <div class="row row2">
                                        <div class="col-sm-4">
                                            <label class="form-label req">Form Header Name</label>
                                            <input type="text" id="formNameHeader" class="form-control border-primary" asp-for="SubMenuForm.FormNameHeader" />
                                        </div>
                                        <div class="col-sm-6">
                                            <label class="form-label req">Page URL</label>
                                            <input type="text" class="form-control border-primary" asp-for="SubMenuForm.PageUrl" />
                                        </div>
                                        <div class="col-sm-2">
                                            <label class="form-label">Icon Image Name</label>
                                            <input type="text" class="form-control border-primary" asp-for="SubMenuForm.IconImagename" />
                                        </div>
                                        <div class="col-sm-4" style="display:none">
                                            <label class="form-label">Report Page URL</label>
                                            <input type="text" class="form-control border-primary" asp-for="SubMenuForm.ReportPageUrl" />
                                        </div>
                                    </div>


                                    <!-- ROW 4: Upload Icon Image, Upload Help File -->
                                   
                                        <div class="row row2">
                                        
                                            <div class="col-sm-6">
                                                <label class="col-auto col-form-label">Upload Icon Image</label>
                                                <div class="col-auto">
                                                    <input type="file" class="form-control border-primary" id="iconImage" name="iconImage" />
                                                </div>
                                            </div>
                                            <div class="col-sm-6">
                                                <label class="col-auto col-form-label">Upload Help File</label>
                                                <div class="col-auto">
                                                    <input type="file" class="form-control border-primary" id="helpFile" name="helpFile" />
                                                </div>
                                            </div>
                                        </div>
                                   

                                    <!-- ROW 5: User Access, Order Number, YouTube Video Hash -->
                                 
                                        <div class="row row2">
                                            <div class="col-sm-4">
                                                <label class="form-label req">Assign from User Access</label>
                                                <select class="form-control form-select border-primary" asp-for="SubMenuForm.AccessType">
                                                <option value="">-Select System Type-</option>
                                                <option value="A">All User Access Form</option>
                                                <option value="S">Single  User Access Form</option>
                                                </select>
                                            </div>
                                            <div class="col-sm-4">
                                                <label class="form-label">Order Number</label>
                                                <select class="form-control form-select border-primary" asp-for="SubMenuForm.OrderNo" id="orderNumber">
                                                    <option value="">--Select Order No--</option>
                                                    @for (int i = 1; i <= 30; i++)
                                                    {
                                                        <option value="@i">Order @i</option>
                                                    }
                                                </select>
                                            </div>
                                            <div class="col-sm-4">
                                                <label class="form-label">Youtube Video Hash</label>
                                                <input type="text" class="form-control border-primary" asp-for="SubMenuForm.VideoUrl" />
                                            </div>
                                        </div>
                                    

                                    <!-- ROW 6: Checkboxes row 1 -->
                                 
                                        <div class="row row2">
                                            <div class="col-lg mt-4">
                                                <div class="form-check">
                                                    <input class="form-check-input border-primary" type="checkbox" asp-for="SubMenuForm.MakeDashboardMain" />
                                                    <label class="form-check-label mx-3">Set as Dashboard Main Menu</label>
                                                </div>
                                            </div>
                                            <div class="col-lg mt-4">
                                                <div class="form-check">
                                                    <input class="form-check-input border-primary" type="checkbox" asp-for="SubMenuForm.ShowonDashboard" />
                                                    <label class="form-check-label mx-3">Show icon on dashboard</label>
                                                </div>
                                            </div>
                                            <div class="col-lg mt-4">
                                                <div class="form-check">
                                                <input class="form-check-input border-primary" type="checkbox" asp-for="SubMenuForm.IsReport" />
                                                <label class="form-check-label mx-3">Is a report</label>
                                                </div>
                                            </div>
                                            
                                        </div>
                                   

                                    <!-- ROW 7: Checkboxes row 2 -->
                                
                                        <div class="row row2">
                                        <div class="col-lg mt-3">
                                            <div class="form-check">
                                                <input class="form-check-input border-primary" type="checkbox" asp-for="SubMenuForm.Deactivate" />
                                                <label class="form-check-label mx-3">Deactivate</label>
                                            </div>
                                        </div>
                                            <div class="col-lg mt-3">
                                                <div class="form-check">
                                                    <input class="form-check-input border-primary" type="checkbox" asp-for="SubMenuForm.IsApprform" />
                                                    <label class="form-check-label mx-3">Is approval form</label>
                                                </div>
                                            </div>
                                            <div class="col-lg mt-4">
                                                <div class="form-check">
                                                    <input class="form-check-input border-primary" type="checkbox" asp-for="SubMenuForm.Approval" />
                                                    <label class="form-check-label mx-3">Pass Through Approval Process</label>
                                                </div>
                                            </div>
                                        </div>
                                
                                    <!-- footer BUTTONS -->
                                    <div class="mt-3" style="margin-bottom:2%">
                                        <button type="button" class="btn btn-success text-light" id="saveBtn-bottom">Save</button>
                                        <button type="button" class="btn btn-warning" id="refreshBtn-bottom">Refresh</button>
                                        <button type="button" class="btn btn-primary" id="viewListBtn-bottom">View List</button>
                                    </div>
                                </div>
                              

                            </div>
                            <!-- END FORM SECTION -->
                            <!-- ═══════════════════════════════════════════════════════════════ -->
                            <!-- VIEW LIST SECTION — hidden by default, shown when View List clicked -->
                            <!-- ═══════════════════════════════════════════════════════════════ -->
                            <div id="listSection" style="display:none;">
                                <div class="card-body">

                                    <!-- Filter dropdowns for the list -->
                                    <div class="row g-4 mb-3">
                                        <div class="col-sm-6">
                                            <label class="form-label">System Type Name</label>
                                            <select class="form-control form-select border-primary" id="listSystemType">
                                                <option value="">-Select System Name-</option>
                                                @foreach (var item in Model.SystemTypeList)
                                                {
                                                    <option value="@item.Value">@item.Text</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="col-sm-6">
                                            <label class="form-label">Module Name</label>
                                            <select class="form-control form-select border-primary" id="listModule" disabled>
                                                <option value="">-Select Module Name-</option>
                                            </select>
                                        </div>
                                        <div class="col-sm-6">
                                            <label class="form-label">Main Menu Name</label>
                                            <select class="form-control form-select border-primary" id="listMainMenu" disabled>
                                                <option value="">-Select Main Menu-</option>
                                            </select>
                                        </div>
                                        <div class="col-sm-6">
                                            <label class="form-label">Menu Name</label>
                                            <select class="form-control form-select border-primary" id="listMenu" disabled>
                                                <option value="">-Select Menu Name-</option>
                                            </select>
                                        </div>
                                    </div>

                                    <!-- Fetch button -->
                                    <!-- Fetch button -->
                                    <div class="mb-3">
                                        <button type="button" class="btn btn-primary" id="fetchBtn">Fetch</button>
                                        <button type="button" class="btn btn-warning" id="listRefreshBtn">Refresh</button>
                                        <button type="button" class="btn btn-success text-light" id="addNewBtn">Add New</button>
                                    </div>

                                    <!-- Results table — hidden until Fetch is clicked -->
                                    <div id="listTableWrapper" style="display:none;">
                                        <table class="table table-bordered display nowrap" id="listTableMenu" style="width:100%">
                                            <thead class="table-light">
                                                <tr>
                                                    <th style="text-align:center;padding:10px; border:1px solid lightgrey; text-transform:none;">Action</th>
                                                    <th style="text-align:center;padding:10px; border:1px solid lightgrey; text-transform:none;">S/N</th>
                                                    <th style="text-align:center;padding:10px; border:1px solid lightgrey; text-transform:none;">SubMenu Code</th>
                                                    <th style="text-align:center;padding:10px; border:1px solid lightgrey; text-transform:none;">SubMenu Name</th>
                                                    <th style="text-align:center;padding:10px; border:1px solid lightgrey; text-transform:none;">Page URL</th>
                                                </tr>
                                            </thead>
                                            <tbody id="listTableBody">
                                                <!-- Rows injected by JS after Fetch -->
                                            </tbody>
                                        </table>
                                    </div>

                                </div>
                            </div>
                            <!-- END VIEW LIST SECTION -->

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>
</form>
@section Scripts {
    <script>
        // ═══════════════════════════════════════════════════════════════════════════
        // SECTION TOGGLE — Form vs View List
        // ═══════════════════════════════════════════════════════════════════════════

        const formSection = document.getElementById('formSection');
        const listSection = document.getElementById('listSection');

        ['viewListBtn-top', 'viewListBtn-bottom'].forEach(id => {
            document.getElementById(id).addEventListener('click', function () {
                const listIsVisible = listSection.style.display === 'block';
                if (listIsVisible) {
                    listSection.style.display = 'none';
                    formSection.style.display = 'block';
                    document.getElementById('viewListBtn-top').style.display    = 'inline-block';
                    document.getElementById('viewListBtn-bottom').style.display = 'inline-block';
                    document.getElementById('viewListBtn-top').textContent      = 'View List';
                    document.getElementById('viewListBtn-bottom').textContent   = 'View List';
                } else {
                    formSection.style.display = 'none';
                    listSection.style.display = 'block';
                    document.getElementById('viewListBtn-top').style.display    = 'none';
                    document.getElementById('viewListBtn-bottom').style.display = 'none';
                }
            });
        });

        ['refreshBtn-top', 'refreshBtn-bottom'].forEach(id => {
            document.getElementById(id).addEventListener('click', function () {
                listSection.style.display = 'none';
                formSection.style.display = 'block';
                clearForm();
                document.getElementById('viewListBtn-top').style.display    = 'inline-block';
                document.getElementById('viewListBtn-bottom').style.display = 'inline-block';
                document.getElementById('viewListBtn-top').textContent      = 'View List';
                document.getElementById('viewListBtn-bottom').textContent   = 'View List';
            });
        });

        ['saveBtn-top', 'saveBtn-bottom'].forEach(id => {
            document.getElementById(id).addEventListener('click', async function () {
                await saveForm();
            });
        });

        document.getElementById('listRefreshBtn').addEventListener('click', function () {
            resetDropdown(listModule,   "--Select Module Name--");
            resetDropdown(listMainMenu, "--Select Main Menu--");
            resetDropdown(listMenu,     "--Select Menu Name--");
            listSystemType.value = '';
            resetListTable();
        });

        document.getElementById('addNewBtn').addEventListener('click', function () {
            listSection.style.display = 'none';
            formSection.style.display = 'block';
            clearForm();
            document.getElementById('viewListBtn-top').style.display    = 'inline-block';
            document.getElementById('viewListBtn-bottom').style.display = 'inline-block';
            document.getElementById('viewListBtn-top').textContent      = 'View List';
            document.getElementById('viewListBtn-bottom').textContent   = 'View List';
        });

        // ═══════════════════════════════════════════════════════════════════════════
        // DUPLICATE CHECK HELPERS
        // ═══════════════════════════════════════════════════════════════════════════

        // Returns the current record's Id (0 when creating new)
        function getCurrentId() {
            return parseInt(document.getElementById('hiddenId').value || '0', 10);
        }

        // Calls the server and returns { subMenuCodeTaken, subMenuNameTaken, pageUrlTaken }
        async function checkDuplicates(subMenuCode, subMenuName, pageUrl) {
            const excludeId = getCurrentId();
            const res = await fetch(
                `?handler=CheckDuplicate` +
                `&subMenuCode=${encodeURIComponent(subMenuCode)}` +
                `&subMenuName=${encodeURIComponent(subMenuName)}` +
                `&pageUrl=${encodeURIComponent(pageUrl)}` +
                `&excludeId=${excludeId}`
            );
            return await res.json();
        }

        // ── Inline feedback helpers ───────────────────────────────────────────────

        function setFieldError(inputEl, message) {
            inputEl.classList.add('is-invalid');
            inputEl.classList.remove('is-valid');
            let fb = inputEl.nextElementSibling;
            if (!fb || !fb.classList.contains('invalid-feedback')) {
                fb = document.createElement('div');
                fb.className = 'invalid-feedback';
                inputEl.parentNode.insertBefore(fb, inputEl.nextSibling);
            }
            fb.textContent = message;
        }

        function clearFieldError(inputEl) {
            inputEl.classList.remove('is-invalid');
            const fb = inputEl.nextElementSibling;
            if (fb && fb.classList.contains('invalid-feedback')) fb.remove();
        }

        // ── Blur listeners — check one field at a time on leave ───────────────────

        const subMenuCodeInput = document.querySelector('[name="SubMenuForm.SubMenuCode"]');
        const subMenuNameInput = document.querySelector('[name="SubMenuForm.SubMenuName"]');
        const pageUrlInput     = document.querySelector('[name="SubMenuForm.PageUrl"]');

        subMenuCodeInput.addEventListener('blur', async function () {
            const val = this.value.trim();
            if (!val) return;
            try {
                const result = await checkDuplicates(val, '', '');
                if (result.subMenuCodeTaken) {
                    setFieldError(this, 'This SubMenu Code / FormID is already in use.');
                } else {
                    clearFieldError(this);
                }
            } catch { /* silent — save-time check will catch it */ }
        });

        subMenuNameInput.addEventListener('blur', async function () {
            const val = this.value.trim();
            if (!val) return;
            try {
                const result = await checkDuplicates(subMenuCodeInput.value, val, '');
                if (result.subMenuNameTaken) {
                    setFieldError(this, 'This SubMenu Name is already in use.');
                } else {
                    clearFieldError(this);
                }
            } catch { /* silent */ }
        });

        pageUrlInput.addEventListener('blur', async function () {
            const val = this.value.trim();
            if (!val) return;
            try {
                const result = await checkDuplicates(subMenuCodeInput.value, subMenuNameInput.value, val);
                if (result.pageUrlTaken) {
                    setFieldError(this, 'This Page URL is already in use.');
                } else {
                    clearFieldError(this);
                }
            } catch { /* silent */ }
        });

        // ═══════════════════════════════════════════════════════════════════════════
        // VALIDATION — required fields + duplicate check before save
        // ═══════════════════════════════════════════════════════════════════════════

        async function validateForm() {
            const systemId   = document.getElementById('systemTypeId').value;
            const moduleId   = document.getElementById('moduleName').value;
            const mainMenuId = document.getElementById('mainMenuName').value;
            const menuId     = document.getElementById('menuName').value;
            const formNameHeader     = document.getElementById('formNameHeader').value;
            const subCode    = subMenuCodeInput.value.trim();
            const subName    = subMenuNameInput.value.trim();
            const pageUrl    = pageUrlInput.value.trim();

            // ── Required field checks ─────────────────────────────────────────────
            if (!systemId) {
                Swal.fire({ icon: 'warning', title: 'Validation', text: 'Please select a System Type.' });
                return false;
            }
            if (!moduleId) {
                Swal.fire({ icon: 'warning', title: 'Validation', text: 'Please select a Module Name.' });
                return false;
            }
            if (!mainMenuId) {
                Swal.fire({ icon: 'warning', title: 'Validation', text: 'Please select a Main Menu Name.' });
                return false;
            }
            if (!menuId) {
                Swal.fire({ icon: 'warning', title: 'Validation', text: 'Please select a Menu Name.' });
                return false;
            }
            if (!subCode) {
                Swal.fire({ icon: 'warning', title: 'Validation', text: 'Please enter a SubMenu Code / FormID.' });
                return false;
            }
            if (!subName) {
                Swal.fire({ icon: 'warning', title: 'Validation', text: 'Please enter a SubMenu Name.' });
                return false;
            }
            if (!formNameHeader) {
                Swal.fire({ icon: 'warning', title: 'Validation', text: 'Please enter a SubMenu Header Name.' });
                return false;
            }
            if (!pageUrl) {
                Swal.fire({ icon: 'warning', title: 'Validation', text: 'Please enter a Page URL.' });
                return false;
            }

            // ── Duplicate check ───────────────────────────────────────────────────
            Swal.fire({
                title: 'Checking...',
                text: 'Validating your entries.',
                allowOutsideClick: false,
                didOpen: () => Swal.showLoading()
            });

            let dupeResult;
            try {
                dupeResult = await checkDuplicates(subCode, subName, pageUrl);
            } catch {
                Swal.close();
                // Network error — let save proceed rather than block the user
                return true;
            }

            Swal.close();

            // Collect all conflicts so user sees everything at once
            const conflicts = [];
            if (dupeResult.subMenuCodeTaken) {
                conflicts.push('• SubMenu Code / FormID is already in use');
                setFieldError(subMenuCodeInput, 'This SubMenu Code / FormID is already in use.');
            } else {
                clearFieldError(subMenuCodeInput);
            }
            if (dupeResult.subMenuNameTaken) {
                conflicts.push('• SubMenu Name is already in use');
                setFieldError(subMenuNameInput, 'This SubMenu Name is already in use.');
            } else {
                clearFieldError(subMenuNameInput);
            }
            if (dupeResult.pageUrlTaken) {
                conflicts.push('• Page URL is already in use');
                setFieldError(pageUrlInput, 'This Page URL is already in use.');
            } else {
                clearFieldError(pageUrlInput);
            }

            if (conflicts.length > 0) {
                Swal.fire({
                    icon: 'error',
                    title: 'Duplicate Entries Found',
                    html: `The following fields already exist in the system:<br><br>
                           <div style="text-align:left; display:inline-block;">
                               ${conflicts.join('<br>')}
                           </div><br><br>
                           Please use unique values before saving.`,
                    confirmButtonColor: '#dc3545'
                });
                return false;
            }

            return true;
        }

        // ═══════════════════════════════════════════════════════════════════════════
        // SAVE
        // ═══════════════════════════════════════════════════════════════════════════

        async function saveForm() {
            if (!await validateForm()) return;

            const confirm = await Swal.fire({
                icon: 'question',
                title: 'Save Record',
                text: 'Are you sure you want to save this record?',
                showCancelButton: true,
                confirmButtonText: 'Yes, Save',
                cancelButtonText: 'Cancel',
                confirmButtonColor: '#198754',
                cancelButtonColor: '#6c757d'
            });

            if (!confirm.isConfirmed) return;

            Swal.fire({
                title: 'Saving...',
                text: 'Please wait.',
                allowOutsideClick: false,
                didOpen: () => Swal.showLoading()
            });

            const form     = document.getElementById('subMenuForm');
            const formData = new FormData(form);

            try {
                const response = await fetch('', {
                    method: 'POST',
                    body: formData,
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });

                const result = await response.json();

                if (result.status === 'Success') {
                    await Swal.fire({
                        icon: 'success',
                        title: 'Saved!',
                        text: result.statusDescription || 'Record saved successfully.',
                        confirmButtonColor: '#198754'
                    });
                    clearForm();
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Save Failed',
                        text: result.statusDescription || 'An error occurred while saving.',
                        confirmButtonColor: '#dc3545'
                    });
                }
            } catch (err) {
                Swal.fire({
                    icon: 'error',
                    title: 'Unexpected Error',
                    text: 'An unexpected error occurred. Please try again.',
                    confirmButtonColor: '#dc3545'
                });
                console.error('Save error:', err);
            }
        }

        // ═══════════════════════════════════════════════════════════════════════════
        // HELPER — clear all form fields, errors, and reset dropdowns
        // ═══════════════════════════════════════════════════════════════════════════

        function clearForm() {
            document.getElementById('subMenuForm').reset();
            document.getElementById('hiddenId').value         = '';
            document.getElementById('systemTypeHidden').value = '';
            document.getElementById('moduleHidden').value     = '';
            document.getElementById('mainMenuHidden').value   = '';
            document.getElementById('menuHidden').value       = '';

            // Clear any lingering inline duplicate errors
            [subMenuCodeInput, subMenuNameInput, pageUrlInput].forEach(clearFieldError);

            resetDropdown(document.getElementById('moduleName'),   "--Select Module Name--");
            resetDropdown(document.getElementById('mainMenuName'), "--Select Main Menu--");
            resetDropdown(document.getElementById('menuName'),     "--Select Menu Name--");
            document.getElementById('systemTypeId').value = '';
        }

        // ═══════════════════════════════════════════════════════════════════════════
        // HELPER — reset a dropdown to a placeholder and disable it
        // ═══════════════════════════════════════════════════════════════════════════

        function resetDropdown(selectEl, placeholder) {
            selectEl.innerHTML = `<option value="">${placeholder}</option>`;
            selectEl.disabled  = true;
        }

        // ═══════════════════════════════════════════════════════════════════════════
        // HELPER — populate a dropdown from a JSON array { value, text }
        // ═══════════════════════════════════════════════════════════════════════════

        function populateDropdown(selectEl, data, mode) {
            if (mode === "Menu") {
                const def       = document.createElement('option');
                def.value       = "All";
                def.textContent = "All Menus";
                selectEl.appendChild(def);
            }
            data.forEach(item => {
                const opt       = document.createElement('option');
                opt.value       = item.value;
                opt.textContent = item.text;
                selectEl.appendChild(opt);
            });
            selectEl.disabled = false;
        }

        // ═══════════════════════════════════════════════════════════════════════════
        // HELPER — reset the results table
        // ═══════════════════════════════════════════════════════════════════════════

        function resetListTable() {
            subTable.clear().draw();
            document.getElementById('listTableWrapper').style.display = 'none';
        }

        // ═══════════════════════════════════════════════════════════════════════════
        // FORM CASCADE
        // ═══════════════════════════════════════════════════════════════════════════

        const systemTypeSelect = document.getElementById('systemTypeId');
        const moduleSelect     = document.getElementById('moduleName');
        const mainMenuSelect   = document.getElementById('mainMenuName');
        const menuSelect       = document.getElementById('menuName');

        systemTypeSelect.addEventListener('change', async function () {
            const systemId = this.value;
            document.getElementById('systemTypeHidden').value = systemId;
            resetDropdown(moduleSelect,   "--Select Module Name--");
            resetDropdown(mainMenuSelect, "--Select Main Menu--");
            resetDropdown(menuSelect,     "--Select Menu Name--");
            if (!systemId) return;
            try {
                const res = await fetch(`?handler=ModulesBySystem&systemId=${systemId}`);
                populateDropdown(moduleSelect, await res.json(), "");
            } catch (err) {
                Swal.fire({ icon: 'error', title: 'Error', text: 'Failed to load modules.' });
                console.error(err);
            }
        });

        moduleSelect.addEventListener('change', async function () {
            const moduleId = this.value;
            const systemId = systemTypeSelect.value;
            document.getElementById('moduleHidden').value = moduleId;
            resetDropdown(mainMenuSelect, "--Select Main Menu--");
            resetDropdown(menuSelect,     "--Select Menu Name--");
            if (!moduleId) return;
            try {
                const res = await fetch(`?handler=MainMenusByModule&systemId=${systemId}&moduleId=${moduleId}`);
                populateDropdown(mainMenuSelect, await res.json(), "");
            } catch (err) {
                Swal.fire({ icon: 'error', title: 'Error', text: 'Failed to load main menus.' });
                console.error(err);
            }
        });

        mainMenuSelect.addEventListener('change', async function () {
            const mainMenuId = this.value;
            document.getElementById('mainMenuHidden').value = mainMenuId;
            resetDropdown(menuSelect, "--Select Menu Name--");
            if (!mainMenuId) return;
            try {
                const res = await fetch(`?handler=MenusByMainMenu&mainMenuId=${mainMenuId}`);
                populateDropdown(menuSelect, await res.json(), "");
            } catch (err) {
                Swal.fire({ icon: 'error', title: 'Error', text: 'Failed to load menus.' });
                console.error(err);
            }
        });

        menuSelect.addEventListener('change', function () {
            document.getElementById('menuHidden').value = this.value;
        });

        // ═══════════════════════════════════════════════════════════════════════════
        // LIST CASCADE
        // ═══════════════════════════════════════════════════════════════════════════

        const listSystemType = document.getElementById('listSystemType');
        const listModule     = document.getElementById('listModule');
        const listMainMenu   = document.getElementById('listMainMenu');
        const listMenu       = document.getElementById('listMenu');

        listSystemType.addEventListener('change', async function () {
            resetDropdown(listModule,   "--Select Module Name--");
            resetDropdown(listMainMenu, "--Select Main Menu--");
            resetDropdown(listMenu,     "--Select Menu Name--");
            resetListTable();
            if (!this.value) return;
            try {
                const res = await fetch(`?handler=ModulesBySystem&systemId=${this.value}`);
                populateDropdown(listModule, await res.json(), "");
            } catch (err) {
                Swal.fire({ icon: 'error', title: 'Error', text: 'Failed to load modules.' });
                console.error(err);
            }
        });

        listModule.addEventListener('change', async function () {
            resetDropdown(listMainMenu, "--Select Main Menu--");
            resetDropdown(listMenu,     "--Select Menu Name--");
            resetListTable();
            if (!this.value) return;
            try {
                const res = await fetch(`?handler=MainMenusByModule&systemId=${listSystemType.value}&moduleId=${this.value}`);
                populateDropdown(listMainMenu, await res.json(), "");
            } catch (err) {
                Swal.fire({ icon: 'error', title: 'Error', text: 'Failed to load main menus.' });
                console.error(err);
            }
        });

        listMainMenu.addEventListener('change', async function () {
            resetDropdown(listMenu, "--Select Menu Name--");
            resetListTable();
            if (!this.value) return;
            try {
                const res = await fetch(`?handler=MenusByMainMenu&mainMenuId=${this.value}`);
                populateDropdown(listMenu, await res.json(), "Menu");
            } catch (err) {
                Swal.fire({ icon: 'error', title: 'Error', text: 'Failed to load menus.' });
                console.error(err);
            }
        });

        listMenu.addEventListener('change', function () {
            resetListTable();
        });

        // ═══════════════════════════════════════════════════════════════════════════
        // FETCH BUTTON
        // ═══════════════════════════════════════════════════════════════════════════

        document.getElementById('fetchBtn').addEventListener('click', async function () {
            const moduleId   = listModule.value;
            const mainMenuId = listMainMenu.value;
            const menuId     = listMenu.value;

            if (!moduleId || !mainMenuId || !menuId) {
                Swal.fire({ icon: 'warning', title: 'Validation', text: 'Please select all four dropdowns before fetching.' });
                return;
            }

            Swal.fire({ title: 'Loading...', text: 'Fetching records, please wait.', allowOutsideClick: false, didOpen: () => Swal.showLoading() });

            try {
                const res  = await fetch(`?handler=SubMenuList&moduleId=${moduleId}&mainMenuId=${mainMenuId}&menuId=${menuId}`);
                const data = await res.json();

                subTable.clear();

                if (data.length === 0) {
                    Swal.fire({ icon: 'info', title: 'No Records', text: 'No submenus found for the selected filters.' });
                    return;
                }

                data.forEach((item, index) => {
                    subTable.row.add([
                        `<button type="button" class="btn btn-sm btn-primary" onclick="selectRecord(${item.id})">Select</button>`,
                        index + 1,
                        item.subMenuCode ?? '',
                        item.subMenuName ?? '',
                        item.pageUrl     ?? ''
                    ]);
                });

                subTable.draw();
                document.getElementById('listTableWrapper').style.display = 'block';
                Swal.close();

            } catch (err) {
                Swal.fire({ icon: 'error', title: 'Error', text: 'Failed to load records. Please try again.' });
                console.error(err);
            }
        });

        // ═══════════════════════════════════════════════════════════════════════════
        // SELECT RECORD
        // ═══════════════════════════════════════════════════════════════════════════

        async function selectRecord(id) {
            Swal.fire({ title: 'Loading...', text: 'Fetching record details.', allowOutsideClick: false, didOpen: () => Swal.showLoading() });

            try {
                const res  = await fetch(`?handler=SubMenuById&id=${id}`);
                const item = await res.json();

                listSection.style.display = 'none';
                formSection.style.display = 'block';
                document.getElementById('viewListBtn-top').style.display    = 'inline-block';
                document.getElementById('viewListBtn-bottom').style.display = 'inline-block';
                document.getElementById('viewListBtn-top').textContent      = 'View List';
                document.getElementById('viewListBtn-bottom').textContent   = 'View List';

                document.getElementById('hiddenId').value         = item.id            ?? '';
                document.getElementById('systemTypeHidden').value = item.systemId      ?? '';
                document.getElementById('moduleHidden').value     = item.moduleSetupId ?? '';
                document.getElementById('mainMenuHidden').value   = item.mainMenuId    ?? '';
                document.getElementById('menuHidden').value       = item.menuId        ?? '';

                subMenuCodeInput.value = item.subMenuCode    ?? '';
                subMenuNameInput.value = item.subMenuName    ?? '';
                pageUrlInput.value     = item.pageUrl        ?? '';

                document.querySelector('[name="SubMenuForm.FormNameHeader"]').value = item.formNameHeader ?? '';
                document.querySelector('[name="SubMenuForm.ReportPageUrl"]').value  = item.reportPageUrl  ?? '';
                document.querySelector('[name="SubMenuForm.IconImagename"]').value  = item.iconImagename  ?? '';
                document.querySelector('[name="SubMenuForm.OrderNo"]').value        = item.orderNo        ?? '';
                document.querySelector('[name="SubMenuForm.VideoUrl"]').value       = item.videoUrl       ?? '';
                document.querySelector('[name="SubMenuForm.AccessType"]').value     = item.accessType     ?? '';

                document.querySelector('[name="SubMenuForm.MakeDashboardMain"]').checked = item.makeDashboardMain ?? false;
                document.querySelector('[name="SubMenuForm.ShowonDashboard"]').checked   = item.showonDashboard   ?? false;
                document.querySelector('[name="SubMenuForm.IsReport"]').checked          = item.isReport          ?? false;
                document.querySelector('[name="SubMenuForm.Deactivate"]').checked        = item.deactivate        ?? false;
                document.querySelector('[name="SubMenuForm.IsApprform"]').checked        = item.isApprform        ?? false;
                document.querySelector('[name="SubMenuForm.Approval"]').checked          = item.approval          ?? false;

                // Clear any stale inline errors from a previous edit
                [subMenuCodeInput, subMenuNameInput, pageUrlInput].forEach(clearFieldError);

                await rebuildFormCascade(item.systemId, item.moduleSetupId, item.mainMenuId, item.menuId);

                Swal.close();

            } catch (err) {
                Swal.fire({ icon: 'error', title: 'Error', text: 'Failed to load record details. Please try again.' });
                console.error(err);
            }
        }

        // ═══════════════════════════════════════════════════════════════════════════
        // REBUILD CASCADE
        // ═══════════════════════════════════════════════════════════════════════════

        async function rebuildFormCascade(systemId, moduleId, mainMenuId, menuId) {
            systemTypeSelect.value = systemId ?? '';
            resetDropdown(moduleSelect,   "--Select Module Name--");
            resetDropdown(mainMenuSelect, "--Select Main Menu--");
            resetDropdown(menuSelect,     "--Select Menu Name--");

            if (!systemId) return;
            const modRes = await fetch(`?handler=ModulesBySystem&systemId=${systemId}`);
            populateDropdown(moduleSelect, await modRes.json(), "");
            moduleSelect.value = moduleId ?? '';

            if (!moduleId) return;
            const mainRes = await fetch(`?handler=MainMenusByModule&systemId=${systemId}&moduleId=${moduleId}`);
            populateDropdown(mainMenuSelect, await mainRes.json(), "");
            mainMenuSelect.value = mainMenuId ?? '';

            if (!mainMenuId) return;
            const menuRes = await fetch(`?handler=MenusByMainMenu&mainMenuId=${mainMenuId}`);
            populateDropdown(menuSelect, await menuRes.json(), "");
            menuSelect.value = menuId ?? '';
        }

    </script>
}