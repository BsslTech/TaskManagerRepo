@page
@model BSSLTaskManagement.Pages.Menu.SystemMenuSetupModel
@{
    ViewData["Title"] = "System Menu Setup";
}

<div class="container mt-4">
    <div class="col-md-12">
        <div class="card card-primary card-outline mb-4">
            <!--begin::Header-->
            <div class="card-header">
                <div class="card-title">System Menu Setup</div>
            </div>
            <!--end::Header-->
            <!--begin::Form-->
            <form>
                <!--begin::Body-->
                <div class="card-body">
                    <div class="row g-3">
        
                        <div class="col-sm-3">
                            <label class="form-label">Menu Code</label>
                            <input hidden class="form-control" type="text" name="SysteMenu.Id" value="" />
                            <div class="input-group">
                                <input type="text" class="form-control" name="SystemMenu.Code" />
                            </div>
                        </div>

                        <div class="col-sm-3">
                            <label class="form-label" for="inputMenuName">Menu Name</label>
                            <input type="text" class="form-control" id="FormID" />
                        </div>
                    </div>
                </div>



                <!--end::Body-->
                <!--begin::Footer-->

                <div class="mt-3">
                    <div class="card-footer ">
                        <button type="submit" class="btn btn-success">Submit</button>
                        <button type="submit" class="btn btn-danger text-light">Cancel</button>
                    </div>
                </div>

                <!--end::Footer-->
            </form>
            <!--end::Form-->
        </div>
    </div>



    <div class="card mb-4">

        <!-- /.card-header -->

        <div class="card-body p-0">
            <table class="table table-sm table-bordered mb-0 text-center">
                <thead>
                    <tr>
                        <th style="text-align:center;padding:10px; border:1px solid lightgrey; text-transform:none;">Action</th>
                        <th style="text-align:center;padding:10px; border:1px solid lightgrey; text-transform:none;">S/N</th>
                        <th style="text-align:center;padding:10px; border:1px solid lightgrey; text-transform:none;">Menu Code</th>
                        <th style="text-align:center;padding:10px; border:1px solid lightgrey; text-transform:none;">Menu Name</th>
                    </tr>
                </thead>
                <tbody>
                    <tr class="align-middle">
                        <td style="text-align:center;padding:10px;border:1px solid lightgrey;">
                        <button type="button" class="btn btn-primary searchControl">
                            Select</button>
                        </td>
                        <td style="text-align:left;padding:10px;border:1px solid lightgrey;">1</td>
                        <td class="text-start">CH</td>
                        <td class="text-start">Chart of Account</td>
                    </tr>
                </tbody>
            </table>
        </div>
        <!-- /.card-body -->
    </div>
</div>