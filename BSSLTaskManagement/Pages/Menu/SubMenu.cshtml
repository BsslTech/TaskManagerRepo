@page
@model BSSLTaskManagement.Pages.Menu.SubMenuModel
@{
}
<div class="container mt-4">
    <div class="col-md-12">
        <div class="card card-primary card-outline mb-4">
            <!--begin::Header-->
            <div class="card-header">
                <div class="card-title">System Defined Menu Setup</div>
            </div>
            <!--end::Header-->
            <!--begin::Form-->
            <form>
                <!--begin::Body-->
                <div class="card-body">
                           <div class="row g-3  ">
                                <div class="col-sm-4">
                                    <label for="clientName" class="form-label">Menu Name </label>
                                    <select class="form-select" id="Licensetype">
                                        <option selected>-Select-</option>
                                        
                                    </select>
                                </div>

                        <div class="col-sm-3">
                            <label class="form-label">Sub-Menu Code</label>
                            <input hidden class="form-control" type="number" id="myid" name="SystemSubMenu.Id" value="0" />
                            <div class="input-group">
                                <input type="text" readonly id="mcode" class="form-control bg-light" name="SystemSubMenu.MCode" />
                                <input type="text" id="code" class="form-control" name="SystemSubMenu.Code" />
                            </div>
                        </div>

                                <div class="col-sm-5">
                                    <label class="form-label" for="GraceDays">Sub-Menu Name</label>
                                    <input type="number" class="form-control" id="FormID" />
                                </div>
                           </div>
                </div>



                <!--end::Body-->
                <!--begin::Footer-->

                <div class="mt-3">
                    <div class="card-footer ">
                        <button type="submit" class="btn btn-success">Submit</button>
                        <button type="submit" class="btn btn-danger text-light">Cancel</button>
                    </div>
                </div>

                <!--end::Footer-->
            </form>
            <!--end::Form-->
        </div>
    </div>

</div>

<div class="container mt-4">


<div class="card mb-4">

    <!-- /.card-header -->
    <div class="card-body p-0">
        <table class="table table-sm table-bordered mb-0 text-center">
            <thead>
                <tr>
                    <th>Action</th>
                    <th>S/N</th>
                    <th>Menu Name</th>
                    <th>Sub-Menu Name</th>
                    <th>Sub-Menu Name</th>
                </tr>
            </thead>
            <tbody>
                <tr class="align-middle">
                    <td><button type="button" class="btn btn-primary">Select</button></td>
                    <td>1</td>
                    <td class="text-start">Chart of Account</td>
                    <td class="text-start">CH-01</td>
                    <td class="text-start">Account Code</td>
                </tr>
            </tbody>
        </table>
    </div>
    <!-- /.card-body -->
</div>
</div>