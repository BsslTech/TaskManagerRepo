@page
@model BSSLTaskManagement.Pages.Menu.MainMenuSetupModel
@{
    ViewData["Title"] = "Main-Menu";
}

    <div class="card card-primary card-outline mb-4">
        <!--begin::Header-->
        <div class="card-header">
            <div class="card-title">Main-Menu</div>
        </div>
        <!--end::Header-->
        <!--begin::Form-->
        <form>
            <!--begin::Body-->
            <div class="card-body">
                <div class="mb-3 col-4">
                <label for="inputSystemTypeName" class="form-label">System Type Name</label>
                <select class="form-control" id="inputSystemTypeName">
                    <option value="">--Select--</option>
                </select>
                </div>

            <div class="row">
                <div class="mb-3 col-4">
                    <label for="inputModuleName" class="form-label">Module Name:</label>
                    <select class="form-control" id="inputModuleName">
                        <option value="">--Select--</option>
                    </select>
                </div>

                <div class="mb-3 col-6">
                    <label for="inputMainMenuDescription" class="form-label">Main Menu Description:</label>
                    <input type="text" class="form-control" id="inputMainMenuDescription">
                </div>

                <div class="mb-3 col-2">
                    <label for="inputOrderNumber" class="form-label">Order Number</label>
                    <input type="number" class="form-control" id="inputOrderNumber" min="1">
                </div>

            </div>
        </div>
            <!--end::Body-->
            <!--begin::Footer-->
        <div class="card-footer">
            <button type="reset" class="btn btn-warning">Cancel Record</button>
            <button type="submit" class="btn btn-success">Submit</button>
            </div>

            <!--end::Footer-->
        </form>
        <!--end::Form-->

    </div>

     <!--begin::Table-->   

