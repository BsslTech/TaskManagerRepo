@page
@model BSSLTaskManagement.Pages.Menu.MainMenuSetupModel
@{
    ViewData["Title"] = "Main Menu";
}
<form method="post">
    <main class="app-main">

        <div class="app-content-header" style="padding:10px;">
            <div class="container-fluid">
                <!--begin::Row-->
                <div class="row">
                    <div class="col-sm-6">
                        <h3 class="mb-0">Main Menu Setup</h3>
                    </div>
                    <div class="col-sm-6">
                        <ol class="breadcrumb float-sm-end">
                            <li class="breadcrumb-item" style="padding:5px;"><a href="#">Home</a></li>
                            <li class="breadcrumb-item active" aria-current="page" style="padding:5px;">Main Menu Setup</li>
                        </ol>
                    </div>
                </div>
                <!--end::Row-->
            </div>
        </div>

        <div class="card card-primary card-outline mb-4">
            <!--begin::Header-->
            <div class="app-content">
                <!--begin::Container-->
                <div class="container-fluid">
                    <!--end::Header-->
                    <!--begin::Form-->
                    <div class="row">
                        <div class="col-md-12">
                            <!--begin::Body-->
                            <div class="card-body">
                                <h6 class="spn font-italic"></h6>
                                <div class="row">
                                    <div class="mb-3 col-6">
                                        <label for="inputSystemTypeName" class="form-label req">System Type Name</label>
                                        <select class="form-control form-select border-primary" id="inputSystemTypeName">
                                            <option value="">--Select System Type--</option>
                                            @foreach (var item in Model.SystemTypeList)
                                            {
                                                <option value="@item.Value">@item.Text</option>
                                            }
                                        </select>
                                    </div>

                                    <div class="mb-3 col-6">
                                        <label for="inputModuleName" class="form-label req">Module Name:</label>
                                        <select class="form-control form-select border-primary" id="inputModuleName">
                                            <option value="">--Select Module Name--</option>
                                        </select>
                                    </div>

                                </div>

                                <!--end::Body-->
                                <!--begin::Footer-->
                                <div class="mt-3" style="margin-bottom:1%">
                                    <button type="button" class="btn btn-success btnSave">Save</button>
                                    <button type="button" onclick="AddDropdownRow()" class="btn btn-primary">Add New Row</button>
                                    <a href="./MainMenuSetup" class="btn btn-warning">Refresh</a>
                                </div>
                                <table style="width:100%" class="table table-bordered display nowrap" id="MainMenuSetupTable">
                                    <thead>
                                        <tr>
                                            <th style="text-align:center;padding:10px;border:1px solid lightgrey;text-transform:none;">S/N</th>
                                            <th style="text-align:center;padding:10px;border:1px solid lightgrey;text-transform:none;" class="req">Main Menu Description</th>
                                            <th style="text-align:center;padding:10px;border:1px solid lightgrey;text-transform:none;" class="req">Order No.</th>
                                            <th style="text-align:center;padding:10px;border:1px solid lightgrey;text-transform:none;">Action</th>
                                        </tr>
                                    </thead>

                                    <tbody id="tableBody">
                                        <tr id="0" role="row">
                                            <td style="padding:10px; border:1px solid lightgrey; width:20px;">1</td>

                                            <td class="col-1" style="text-align:left;padding:10px;border:1px solid lightgrey;">
                                                <input style="width:450px" type="text" class="form-control border-primary mainMenuDescription" />
                                            </td>

                                            <td class="col-1" style="text-align:center;padding:10px;border:1px solid lightgrey;">
                                                <select style="width:200px" class="form-control form-select border-primary orderNumber" id="orderNumber_1">
                                                    <option value="">--Select Order No--</option>
                                                    @for (int i = 1; i <= 30; i++)
                                                    {
                                                        <option value="@i">Order @i</option>
                                                    }
                                                </select>
                                            </td>

                                            <td style="text-align:center;padding:10px;border:1px solid lightgrey; width:150px">

                                                <button type="button" class="btn btn-danger removeRow">
                                                    <i class="fa fa-trash"></i> Delete Row
                                                </button>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                                <!-- Hidden template row — cloned when Add New Row is clicked -->
                                <table style="display:none">
                                    <tr id="rowTemplate" style="display:none">
                                        <td style="padding:10px; border:1px solid lightgrey; width:20px;" class="sn">1</td>

                                        <td class="col-1" style="text-align:left;padding:10px;border:1px solid lightgrey;">
                                            <input style="width:450px" type="text" class="form-control border-primary mainMenuDescription" />
                                        </td>

                                        <td class="col-1" style="text-align:center;padding:10px;border:1px solid lightgrey;">
                                            <select style="width:200px" class="form-control form-select border-primary orderNumber" id="orderNumber_1">
                                                <option value="">--Select Order No--</option>
                                                @for (int i = 1; i <= 30; i++)
                                                {
                                                    <option value="@i">Order @i</option>
                                                }
                                            </select>
                                        </td>

                                        <td style="text-align:center;padding:10px;border:1px solid lightgrey; width:150px">
                                            @* <button type="button" class="btn btn-primary btn-sm">
                    <i class="fa fa-edit"></i> Edit
                </button> *@
                                            <button type="button" class="btn btn-danger removeRow">
                                                <i class="fa fa-trash"></i> Delete Row
                                            </button>
                                        </td>
                                    </tr>
                                </table>
                                <div class="mt-3" style="margin-bottom:2%">
                                    <button type="button" class="btn btn-success btnSave">Save</button>
                                    <button type="button" onclick="AddDropdownRow()" class="btn btn-primary">Add New Row</button>
                                    <a href="./MainMenuSetup" class="btn btn-warning">Refresh</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>

        // ─── INITIALIZE DATATABLE ──────────────────────────────────────
        let table = $('#MainMenuSetupTable').DataTable({
            paging: true,
            pageLength: 10,
            ordering: false,
            searching: true,
            info: true,
            columnDefs: [{ orderable: false, targets: '_all' }]
        });

        // ─── CASCADE: System Type → Module Name ───────────────────────
        $('#inputSystemTypeName').on('change', function () {
            const systemId = $(this).val();
            $('#inputModuleName').html('<option value="">--Select Module Name--</option>');
            ClearTable();
            if (!systemId) return;

            $.getJSON(`?handler=ModulesBySystem&systemId=${systemId}`, function (data) {
                data.forEach(item => {
                    $('#inputModuleName').append(
                        `<option value="${item.value}">${item.text}</option>`
                    );
                });
            });
        });

        // ─── CASCADE: Module Name → Load Existing Rows ────────────────
        $('#inputModuleName').on('change', function () {
            const moduleId = $(this).val();
            const systemId = $('#inputSystemTypeName').val();
            ClearTable();
            if (!moduleId) return;

            $.getJSON(`?handler=MainMenusByModule&systemId=${systemId}&moduleId=${moduleId}`, function (data) {
                if (data.length === 0) {
                    // No saved data — add a blank starter row
                    AddDropdownRow();
                    return;
                }
                data.forEach((item, index) => {
                    let newRow = $("#rowTemplate").clone().removeAttr("id").show();
                    newRow.find(".sn").text(index + 1);
                    newRow.find(".mainMenuDescription").val(item.description);
                    newRow.find(".mainMenuDescription").attr("data-saved-description", item.savedDescription);
                    newRow.find(".orderNumber").val(item.orderNo);
                    table.row.add(newRow[0]).draw(false);
                });
                table.columns.adjust();
            });
        });

        // ─── ADD NEW ROW ───────────────────────────────────────────────
        function AddDropdownRow() {
            let rowCount = table.rows().count();
            let newRow = $("#rowTemplate").clone().removeAttr("id").show();
            newRow.find(".sn").text(rowCount + 1);
            newRow.find("input").val("");
            table.row.add(newRow[0]).draw(false);

            let newPage = Math.floor(table.rows().count() - 1) / table.page.len();
            table.page(Math.floor(newPage)).draw(false);
            table.columns.adjust();
        }

        // ─── REMOVE ROW ────────────────────────────────────────────────
        $(document).on('click', '.removeRow', function () {
            table.row($(this).closest('tr')).remove().draw(false);
            ReIndexRows();
            table.columns.adjust();
        });

        // ─── RE-INDEX ROWS ─────────────────────────────────────────────
        function ReIndexRows() {
            table.rows().every(function (rowIdx) {
                let row = $(this.node());
                row.attr("id", rowIdx);
                row.find("td:first").text(rowIdx + 1);
            });
        }

        // ─── CLEAR TABLE ───────────────────────────────────────────────
        function ClearTable() {
            table.clear().draw();
        }

        // ─── SAVE ──────────────────────────────────────────────────────
        $(document).on('click', '.btnSave', function () {
            const systemId = $('#inputSystemTypeName').val();
            const moduleId = $('#inputModuleName').val();

            if (!systemId || !moduleId) {
                alert("Please select System Type and Module Name before saving.");
                return;
            }

                    let menuRows = [];
        let hasError = false;
        const seenOrderNumbers = new Set();
        const seenDescriptions = new Set();  // ← ADD THIS
        let hasDuplicate = false;
        let hasDuplicateDesc = false;        // ← ADD THIS

        table.rows().every(function () {
            let row = $(this.node());
            const description = row.find('.mainMenuDescription').val().trim();
            const savedDescription = row.find('.mainMenuDescription').attr('data-saved-description') || description;
            const orderNo = row.find('.orderNumber').val().trim();

            if (!description) {
                hasError = true;
                return;
            }

            // ← ADD: Duplicate description check
            if (seenDescriptions.has(description.toLowerCase())) {
                hasDuplicateDesc = true;
                return false;
            }
            seenDescriptions.add(description.toLowerCase());

            // Duplicate order number check (only if an order number was entered)
            if (orderNo) {
                if (seenOrderNumbers.has(orderNo)) {
                    hasDuplicate = true;
                    return false;
                }
                seenOrderNumbers.add(orderNo);
            }

            menuRows.push({
                description: description,
                savedDescription: savedDescription,
                orderNo: orderNo ? parseInt(orderNo) : null
            });
        });

        if (hasError) {
            alert("Please fill in the Main Menu Description for all rows.");
            return;
        }

        // ← ADD THIS BLOCK
        if (hasDuplicateDesc) {
            Swal.fire('Validation', 'Duplicate descriptions are not allowed. Please ensure each Main Menu Description is unique.', 'warning');
            return;
        }

        if (hasDuplicate) {
            Swal.fire('Validation', 'Duplicate order numbers are not allowed. Please ensure each Order Number is unique.', 'warning');
            return;
        }

            if (menuRows.length === 0) {
                alert("Please add at least one row before saving.");
                return;
            }

            const payload = {
                systemTypeTabId: parseInt(systemId),
                moduleSetupId:   parseInt(moduleId),
                mainMenuSetup:   menuRows
            };
                            $(".loadingDiv-parent").fadeIn("fast");
            $.ajax({
                url: '?handler=SaveMainMenus',
                method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
                success: function (response) {
                $(".loadingDiv-parent").fadeOut("slow");
                    if (response.status === "Success") {
                        Swal.fire({ title: "Success!", text: response.statusDescription, icon: "success" })
                        .then(() => {
                            $(".loadingDiv-parent").fadeIn("fast");
                            //if (window.Loader) window.Loader.fadeIn(window.Loader.parent, 200);// fast fade in
                            window.location.href = window.location.origin + "/Menu/MainMenuSetup";
                        });
                    } else {
                        Swal.fire({ icon: "error", title: "Oops...", text: response.statusDescription });
                    }
                },
                error: function () {
                    Swal.fire({ icon: "error", title: "Oops...", text: "An error occurred while saving. Please try again." });
                }
            });
        });

    </script>
}

