<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
    <!-- Site favicon -->
    <link rel="apple-touch-icon" sizes="180x180" href="/file/vendors/images/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/file/vendors/images/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/file/vendors/images/favicon-16x16.png">

    <!-- Mobile Specific Metas -->
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">

    <!-- Google Font -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- CSS -->
    <link rel="stylesheet" type="text/css" href="/file/vendors/styles/core.css">
    <link rel="stylesheet" type="text/css" href="/file/vendors/styles/icon-font.min.css">
    @*<link rel="stylesheet" type="text/css" href="/file/src/plugins/jquery-steps/jquery.steps.css">*@
    <link rel="stylesheet" type="text/css" href="/file/vendors/styles/style.css">

    <!-- Global site tag (gtag.js) - Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=UA-119386393-1"></script>
    <link rel="stylesheet" href="~/css/dataTable.css" as="style" />
</head>
<body>

    <div>
        @RenderBody()
    </div>

    <footer class="border-top footer text-muted" style="text-align:center">
        <div class="container">
            &copy; @DateTime.Now.Year -   BSSL Technologies Ltd
        </div>
    </footer>
    <script src="/file/vendors/scripts/core.js"></script>
    <script src="/file/vendors/scripts/script.min.js"></script>
    <script src="/file/vendors/scripts/process.js"></script>
    <script src="/file/vendors/scripts/layout-settings.js"></script>
    <script src="/file/src/plugins/jquery-steps/jquery.steps.js"></script>
    <script src="/file/vendors/scripts/steps-setting.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/loader.js" asp-append-version="true"></script>
</body>
@RenderSection("Scripts", required: false)

</html>