@inject TaskManagement.TaskDbContext _taskContext
@using Microsoft.AspNetCore.Http
@using Microsoft.EntityFrameworkCore
@using static TaskManagement.IdentityLib
@inject SignInManager<TaskIdentityUser> SignInManager
@inject UserManager<TaskIdentityUser> UserManager
@inject RoleManager<TaskIdentityRole> roleManager
@{

    var getUseRrole = "";
    var curUser = new TaskIdentityUser(); IList<string> currole = [];
    var getCurUser = new TaskIdentityUser();
    if (SignInManager.IsSignedIn(User))
    {
        curUser = await UserManager.GetUserAsync(User);
        currole = await UserManager.GetRolesAsync(curUser);
        getCurUser = await _taskContext.TaskIdentityUsers.FirstOrDefaultAsync(m => m.UserName == User.Identity.Name);

        if (currole != null)
        {
            var rolem = await roleManager.FindByNameAsync(currole[0]);

            if (currole != null)
            {
                getUseRrole = rolem.Id.ToString();
            }
        }
    }
}

