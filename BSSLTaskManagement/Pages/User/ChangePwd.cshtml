@page
@model BSSLTaskManagement.Pages.User.ChangePwdModel
@{
    ViewData["Title"] = "Change Password";
}

<form method="post" id="menuForm">
    <main class="app-main">
        <input asp-for="ResponseMessage.Status" id="status" type="hidden" />
        <input asp-for="ResponseMessage.StatusDescription" id="statusDescription" type="hidden" />
        <input asp-for="ChPwd.UserName" type="hidden" />
        <input asp-for="ChPwd.Role" type="hidden" />
        <!--begin::App Content Header-->
        <div class="app-content">
            <div class="container-fluid">
                <div class="row">
                    <div class="col-md-12">
                        <!-- Single Save Card -->
                        <div class="card mb-3">
                            <div class="app-content-header">
                                <div class="container-fluid">
                                    <div class="row">
                                        <div class="col-sm-6">
                                            <h3 class="mb-0">Change Password</h3>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="card-body">
                                <h6 class="spn font-italic"></h6>
                                <div class="row">
                                    <div class="col-sm-4">
                                        <label class="form-label">User Code</label>
                                        <div class="input-group">
                                            <!-- ✅ Fixed: Added id for JS and asp-for binding -->
                                            <input type="text" readonly class="form-control border-primary" asp-for="ChPwd.StaffCode"  />
                                        </div>
                                    </div>
                                    <div class="col-sm-4">
                                        <label class="form-label">Staff Name</label>
                                        <!-- ✅ Fixed: Changed id to menuDescription and added name/asp-for -->
                                        <input type="text" readonly class="form-control border-primary" asp-for="ChPwd.Name" id="" />
                                    </div>
                                    <div class="col-sm-4">
                                        <label class="form-label">Staff Email</label>
                                        <!-- ✅ Fixed: Changed id to menuDescription and added name/asp-for -->
                                        <input type="text" readonly class="form-control border-primary" asp-for="ChPwd.Email" id="" />
                                    </div>
                                </div>
                                <div class="row row2">
                                    <div class="col-sm-4">
                                        <label class="form-label req">Current Password</label>
                                        <!-- ✅ Fixed: Changed id to menuDescription and added name/asp-for -->
                                        <input type="password" class="form-control border-primary" asp-for="ChPwd.OldPassword" id="currentPassword" />
                                        <div class="danger">
                                            <span asp-validation-for="ChPwd.OldPassword" class="text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="col-sm-4">
                                        <label class="form-label req">New Password</label>
                                        <!-- ✅ Fixed: Changed id to menuDescription and added name/asp-for -->
                                        <input type="password" class="form-control border-primary" asp-for="ChPwd.Password" id="password" />
                                        <div class="danger">
                                            <span asp-validation-for="ChPwd.Password" class="text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="col-sm-4">
                                        <label class="form-label req">Confirm New Password</label>
                                            <!-- ✅ Fixed: Added id for JS and asp-for binding -->
                                            <input type="password" class="form-control border-primary" asp-for="ChPwd.ConfirmPwd" id="confirm"/>
                                            <div class="danger">
                                                <span asp-validation-for="ChPwd.ConfirmPwd" class="text-danger"></span>
                                            </div>
                                    </div>
                                </div>
                                <div class="mt-3" style="margin-bottom:1.5%">
                                    <button type="submit" style="display:none" id="btnSubmitForm"></button>
                                    <button type="button" class="btn btn-success me-2" id="btnChangePwd">Change Password</button>
                                    <a href="./ChangePwd" class="btn btn-warning">Refresh</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/usermanagement/changePwd.js" asp-append-version="true"></script>
}
