@page
@model BSSLTaskManagement.Pages.SystemPage.ModuleSetupModel
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    ViewData["Title"] = "Module Setup";
}
<form method="post" enctype="multipart/form-data" asp-antiforgery="true">
    <main class="app-main">
        <button type="submit" id="postForm" style="display:none"></button>
        <input asp-for="ResponseMessage.Status" id="status" type="hidden" />
        <input asp-for="ResponseMessage.StatusDescription" id="statusDescription" type="hidden" />
        <div class="app-content-header" style="padding:10px;">
            <div class="container-fluid">
                <!--begin::Row-->
                <div class="row">
                    <div class="col-sm-6">
                        <h3 class="mb-0">Module Setup</h3>
                    </div>
                    <div class="col-sm-6">
                        <ol class="breadcrumb float-sm-end">
                            <li class="breadcrumb-item" style="padding:5px;"><a href="#">Home</a></li>
                            <li class="breadcrumb-item active" aria-current="page" style="padding:5px;">Module Setup</li>
                        </ol>
                    </div>
                </div>
                <!--end::Row-->
            </div>
        </div>

        <div class="card card-primary card-outline mb-4">
            <!--begin::Header-->
            <div class="app-content">
                <!--begin::Container-->
                <div class="container-fluid">
                    <!--end::Header-->
                    <!--begin::Form-->
                    <div class="row">
                        <div class="col-md-12">
                            <!--begin::Body-->
                            <div class="card-body">
                                <h6 class="spn font-italic"></h6>
                                <div class="row">
                                    <div class="mb-3 col-6">
                                        <label for="inputSystemTypeName" class="form-label req">System Type Name</label>
                                        <select class="form-control form-select border-primary" asp-for="ModuleSetup.SystemId" id="inputSystemTypeName" onchange="SystemTypeChange()">
                                            <option value="">--Select System Type--</option>
                                            @foreach (var item in Model.SystemTypesList)
                                            {
                                                <option value="@item.SystemId">@item.SystemDescription</option>
                                            }
                                        </select>
                                    </div>
                                </div>

                                <!--end::Body-->
                                <!--begin::Footer-->
                                <div class="mt-3" style="margin-bottom:2%">
                                    <button type="button" class="btn btn-success btnSave">Save</button>
                                    <button type="button" onclick="AddModuleSetup()" class="btn btn-primary">Add New Row</button>
                                    <a href="./ModuleSetup" class="btn btn-warning">Refresh</a>
                                </div>
                                
                                <table style="width:100%" class="table table-bordered display nowrap" id="moduleSetupTab">
                                    <thead>
                                        <tr>
                                            <th style="text-align:center;padding:10px;border:1px solid lightgrey;text-transform:none;">S/N</th>
                                            <th style="text-align:center;padding:10px;border:1px solid lightgrey;text-transform:none;" class="req">Module Code</th>
                                            <th style="text-align:center;padding:10px;border:1px solid lightgrey;text-transform:none;" class="req">Module Description</th>
                                            <th style="text-align:center;padding:10px;border:1px solid lightgrey;text-transform:none;">Action</th>
                                        </tr>
                                    </thead>

                                    <tbody id="tableBody">
                                        @for (int i = 0; i < Model.ModuleSetup.ModuleDetails.Count; i++)
                                        {
                                            <tr id="@i" role="row">
                                                <td style="padding:10px; border:1px solid lightgrey; width:20px;">@(i+1)</td>

                                                <td class="col-1" style="text-align:left;padding:10px;border:1px solid lightgrey;">
                                                    <input class="code @i" type="hidden" asp-for="ModuleSetup.ModuleDetails[i].SystemCode" />
                                                    <input onchange="UpdateTextFile(this,1,1)" id="moduleCode" asp-for="ModuleSetup.ModuleDetails[i].ModuleCode" style="width:150px" type="text" class="form-control border-primary moduleCode" />
                                                </td>

                                                <td class="col-1" style="text-align:center;padding:10px;border:1px solid lightgrey;">
                                                    <input onchange="UpdateTextFile(this,2,1)" style="width:450px" asp-for="ModuleSetup.ModuleDetails[i].ModuleDescription" type="text" id="moduleDescription" class="form-control border-primary moduleDescription" />
                                                </td>

                                                <td style="text-align:center;padding:10px;border:1px solid lightgrey; width:150px">

                                                    <button type="button" class="btn btn-danger removeRow">
                                                        <i class="fa fa-trash"></i> Delete Row
                                                    </button>
                                                </td>
                                            </tr>
                                            }
                                    </tbody>
                                </table>
                                <!-- Hidden template row — cloned when Add New Row is clicked -->
                                <table style="display:none">
                                    <tr id="rowTemplate" style="display:none">
                                        <td style="text-align:left;padding:10px;border:1px solid lightgrey;"
                                            class="sn">
                                        </td>

                                        <td class="col-1" style="text-align:left;padding:10px;border:1px solid lightgrey;">
                                            <input class="code" type="hidden" name="ModuleSetup.ModuleDetails[0].SystemCode" />
                                            <input id="ModuleSetup.ModuleDetails_0__ModuleCode" 
                                                   onchange="UpdateTextFile(this,1,1)"
                                            name="ModuleSetup.ModuleDetails[0].ModuleCode" style="width:150px" type="text" class="form-control border-primary moduleCode" />
                                        </td>

                                        <td class="col-1" style="text-align:center;padding:10px;border:1px solid lightgrey;">
                                            <input style="width:450px" onchange="UpdateTextFile(this,2,1)" name="ModuleSetup.ModuleDetails[0].ModuleDescription" type="text" id="ModuleSetup.ModuleDetails_0__ModuleDescription" class="form-control border-primary moduleDescription" />
                                        </td>

                                        <td style="text-align:center;padding:10px;border:1px solid lightgrey; width:150px">

                                            <button type="button" class="btn btn-danger removeRow">
                                                <i class="fa fa-trash"></i> Delete Row
                                            </button>
                                        </td>
                                    </tr>
                                </table>
                                <div class="card-footer" style="margin-top:1%">
                                    <button type="button" class="btn btn-success btnSave">Save</button>
                                    <button type="button" onclick="AddModuleSetup()" class="btn btn-primary">Add New Row</button>
                                    <a href="./ModuleSetup" class="btn btn-warning">Refresh</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>
</form>

@* =====================================================================
   Section: Scripts  (injected into _Layout's @RenderSection("Scripts"))
   ===================================================================== *@
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/module.js" asp-append-version="true"></script>
}