@page
@model BSSLTaskManagement.Pages.SystemPage.ModuleSetupModel
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    ViewData["Title"] = "Module Setup";
}
<form method="post" enctype="multipart/form-data" asp-antiforgery="true">
    <main class="app-main">
        <input asp-for="ResponseMessage.Status" id="status" type="hidden" />
        <input asp-for="ResponseMessage.StatusDescription" id="statusDescription" type="hidden" />

@* ── Minimal overrides on top of Bootstrap 5 ── *@
<style>
    .card            { border: none; box-shadow: 0 2px 12px rgba(0,0,0,.08); border-radius: .6rem; }
    .card-header     { border-radius: .6rem .6rem 0 0 !important; }
    .table > :not(caption) > * > * { padding: .65rem 1rem; }
    .badge-code      { font-family: monospace; font-size: .8rem; }
    .sn-badge        { width: 26px; height: 26px; font-size: .72rem;
                       display: inline-flex; align-items: center;
                       justify-content: center; border-radius: 50%; }
    .file-label      { cursor: pointer; }
    #fileNameDisplay { font-size: .82rem; max-width: 260px;
                       overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
</style>

@* ── Page heading ── *@
<div class="d-flex align-items-center gap-2 mb-4">
    <div class="bg-primary bg-gradient rounded p-2 text-white d-flex">
        <i class="bi bi-grid-3x3-gap-fill fs-5"></i>
    </div>
    <div>
        <h4 class="mb-0 fw-bold">Module Setup</h4>
        <small class="text-muted">Configure and manage system modules</small>
    </div>
</div>



