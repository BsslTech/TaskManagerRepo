@page
@model BSSLTaskManagement.Pages.Constituency.StateModel
@{
    ViewData["Title"] = "State Constituency Setup";
}
@section Styles {
    @* {{-- Select2 CSS for searchable dropdowns --}} *@
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" />
}
<form method="post">
                    @Html.AntiForgeryToken()
    <main class="app-main">

        <div class="app-content-header" style="padding:10px;">
            <div class="container-fluid">
                <!--begin::Row-->
                <div class="row">
                    <div class="col-sm-6">
                        <h3 class="mb-0">State Constituency Setup</h3>
                    </div>
                    <div class="col-sm-6">
                        <ol class="breadcrumb float-sm-end">
                            <li class="breadcrumb-item" style="padding:5px;"><a href="#">Home</a></li>
                            <li class="breadcrumb-item active" aria-current="page" style="padding:5px;">State Constituency Setup</li>
                        </ol>
                    </div>
                </div>
                <!--end::Row-->
            </div>
        </div>

        <div class="card card-primary card-outline mb-4">
            <!--begin::Header-->
            <div class="app-content">
                <!--begin::Container-->
                <div class="container-fluid">
                    <!--end::Header-->
                    <!--begin::Form-->
                    <div class="row">
                        <div class="col-md-12">
                            <!--begin::Body-->
                            <div class="card-body">
                                <h6 class="spn font-italic"></h6>
                                <div class="row">
                                    <div class="col-6">
                                        <label for="ddlCountry" class="form-label req">Country</label>
                                        <select class="form-control form-select border-primary" id="ddlCountry" style="width:100%">
                                            <option value="">--Select Country--</option>
                                        </select>
                                    </div>
                                    <div class="col-6">
                                        <label for="ddlState" class="form-label req">State</label>
                                        <select class="form-control form-select border-primary" id="ddlState" style="width:100%" disabled>
                                            <option value="">--Select State--</option>
                                        </select>
                                    </div>
                                </div>



                                @* Card Footer: Add Row + Save buttons *@
                                <div class="mt-3" style="margin-bottom:1%">

                                    <button type="button" class="btn btn-success btnSave" id="btnSave" disabled>
                                        <i class="fas fa-save"></i> Save
                                    </button>
                                    <a href="./State" class="btn btn-warning">Refresh</a>
                                    <button type="button" class="btn btn-primary" id="btnAddRow" disabled>
                                        <i class="fas fa-plus"></i> Add Row
                                    </button>
                                </div>


                                <table style="width:100%" class="table table-bordered display nowrap"  id="tblState">
                                    <thead>
                                        <tr>
                                            <th style="text-align:center;padding:10px;border:1px solid lightgrey;text-transform:none;width:20px">S/N</th>
                                            <th style="text-align:center;padding:10px;border:1px solid lightgrey;text-transform:none;width:150px">Code</th>
                                            <th style="text-align:center;padding:10px;border:1px solid lightgrey;text-transform:none;">Description</th>
                                            <th style="text-align:center;padding:10px;border:1px solid lightgrey;text-transform:none;width:80px">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody id="tblBody">
                                        @* Default empty row visible on page load *@
                                        <tr data-id="0">
                                            <td style="padding:10px; border:1px solid lightgrey; width:20px;">1</td>
                                            <td style="text-align:left;padding:10px;border:1px solid lightgrey;"><input type="text" class="form-control border-primary col-code" placeholder="Code"></td>
                                            <td style="text-align:left;padding:10px;border:1px solid lightgrey;"><input type="text" class="form-control border-primary col-desc" placeholder="Description"></td>
                                            <td style="text-align:center;padding:10px;border:1px solid lightgrey;">
                                                <button type="button" class="btn btn-danger btn-delete-row" title="Delete">
                                                    <i class="fas fa-trash"></i> Delete
                                                </button>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                                <div class="mt-3" style="margin-bottom:2%">

                                    <button type="button" class="btn btn-success btnSave" id="btnSave" disabled>
                                        <i class="fas fa-save"></i> Save
                                    </button>
                                    <a href="./State" class="btn btn-warning">Refresh</a>
                                    <button type="button" class="btn btn-primary" id="btnAddRow" disabled>
                                        <i class="fas fa-plus"></i> Add Row
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>
</form>
@section Scripts {
    @* {{-- Select2 JS --}} *@
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>
        (function() {

        // ── State tracking ───────────────────────────────────────────────────────
        let selectedStateId = 0;

        // ── Antiforgery token (needed for POST requests) ─────────────────────────
        const antiForgeryToken = $('input[name="__RequestVerificationToken"]').val();

        // ════════════════════════════════════════════════════════════════════════
        // INITIALIZE Select2 on both dropdowns
        // ════════════════════════════════════════════════════════════════════════
        $('#ddlCountry').select2({
        theme: 'bootstrap-5',
        placeholder: '--Select Country--',
        allowClear: true,
        width: '100%'
        });

        $('#ddlState').select2({
        theme: 'bootstrap-5',
        placeholder: '--Select State--',
        allowClear: true,
        width: '100%'
        });

        // ════════════════════════════════════════════════════════════════════════
        // ON PAGE LOAD: Populate Country dropdown
        // ════════════════════════════════════════════════════════════════════════
        loadCountries();

        function loadCountries() {
        $.ajax({
        url: '?handler=Countries',
        type: 'GET',
        success: function(data) {
        const ddl = $('#ddlCountry');
        ddl.find('option:not(:first)').remove();
        $.each(data, function(i, item) {
        ddl.append(`<option value="${item.id}">${item.description} (${item.code})</option>`);
        });
        // Refresh Select2 after options are added
        ddl.trigger('change.select2');
        },
        error: function() {
        Swal.fire('Error', 'Failed to load countries.', 'error');
        }
        });
        }

        // ════════════════════════════════════════════════════════════════════════
        // COUNTRY CHANGE: Load matching states
        // Select2 fires the native 'change' event so this works as-is
        // ════════════════════════════════════════════════════════════════════════
        $('#ddlCountry').on('change', function() {
        const countryId = $(this).val();

        // Reset state dropdown and table
        resetStateDropdown();
        clearTable();
        addDefaultRow(); // restore the default empty row
        selectedStateId = 0;
        toggleButtons(false);

        if (!countryId) return;

        $.ajax({
        url: `?handler=StatesByCountry&countryId=${countryId}`,
        type: 'GET',
        success: function(data) {
        const ddl = $('#ddlState');
        ddl.find('option:not(:first)').remove();

        if (data.length === 0) {
        Swal.fire('Info', 'No states found for the selected country.', 'info');
        ddl.trigger('change.select2');
        return;
        }

        $.each(data, function(i, item) {
        ddl.append(`<option value="${item.id}">${item.description} (${item.code})</option>`);
        });

        ddl.prop('disabled', false).trigger('change.select2');
        },
        error: function() {
        Swal.fire('Error', 'Failed to load states.', 'error');
        }
        });
        });

        // ════════════════════════════════════════════════════════════════════════
        // STATE CHANGE: Load existing federal constituency rows
        // ════════════════════════════════════════════════════════════════════════
        $('#ddlState').on('change', function() {
        const stateId = parseInt($(this).val());
        selectedStateId = stateId;
        clearTable();

        if (!stateId) {
        toggleButtons(false);
        addDefaultRow(); // restore default empty row when state is cleared
        return;
        }

        toggleButtons(true);

        $.ajax({
        url: `?handler=StateRows&stateId=${stateId}`,
        type: 'GET',
        success: function (data) {
        if (data.length === 0) {
        // No existing records — just show the default empty row
        addDefaultRow();
        } else {
        // Load existing records then add one blank row at the bottom
        $.each(data, function (i, row) {
        appendRow(row.id, row.code, row.description);
        });
        addNewRow();
        }
        },
        error: function() {
        Swal.fire('Error', 'Failed to load state records.', 'error');
        }
        });
        });

        // ════════════════════════════════════════════════════════════════════════
        // ADD ROW BUTTON
        // ════════════════════════════════════════════════════════════════════════
        $('#btnAddRow').on('click', function() {
        if (selectedStateId <= 0) {
        Swal.fire('Warning', 'Please select a state first.', 'warning');
        return;
        }
        addNewRow();
        });

        // ════════════════════════════════════════════════════════════════════════
        // SAVE BUTTON: Collect all rows and POST to server
        // ════════════════════════════════════════════════════════════════════════
        $('#btnSave').on('click', function() {
        if (selectedStateId <= 0) {
        Swal.fire('Warning', 'Please select a state first.', 'warning');
        return;
        }

        const rows = [];
        let hasError = false;
        const seenCodes = new Set();
        let hasDuplicate = false;

        $('#tblBody tr').each(function() {
        const id = parseInt($(this).data('id') || 0);
        const code = $(this).find('.col-code').val().trim();
        const desc = $(this).find('.col-desc').val().trim();

        // Skip completely empty rows (user left the blank row untouched)
        if (!code && !desc) return;

        if (!code || !desc) {
        hasError = true;
        return false; // break
        }

        // Duplicate code check
        if (seenCodes.has(code.toLowerCase())) {
            hasDuplicate = true;
            return false; //break
        }
        seenCodes.add(code.toLowerCase());

        rows.push({ id, code, description: desc });
        });

        if (hasError) {
        Swal.fire('Validation', 'Each row must have both a Code and a Description.', 'warning');
        return;
        }

        if (hasDuplicate) {
            Swal.fire('Validation', 'Duplicate codes are not allowed. Please ensure each code is unique', 'warning');
            return;
        }

        if (rows.length === 0) {
        Swal.fire('Validation', 'No rows to save.', 'warning');
        return;
        }

        const payload = { stateId: selectedStateId, rows: rows };

        $.ajax({
        url: '?handler=SaveState',
        type: 'POST',
        contentType: 'application/json',
        headers: { 'RequestVerificationToken': antiForgeryToken },
        data: JSON.stringify(payload),
        success: function(result) {
        if (result.success) {
        Swal.fire('Success', result.message, 'success').then(() => {
        reloadRows(selectedStateId);
        });
        } else {
        Swal.fire('Error', result.message, 'error');
        }
        },
        error: function() {
        Swal.fire('Error', 'An unexpected error occurred while saving.', 'error');
        }
        });
        });

        // ════════════════════════════════════════════════════════════════════════
        // DELETE ROW (delegated — works on dynamically added rows)
        // ════════════════════════════════════════════════════════════════════════
        $('#tblBody').on('click', '.btn-delete-row', function() {
        const row = $(this).closest('tr');
        const id = parseInt(row.data('id') || 0);

        if (id === 0) {
        // Unsaved row — remove from DOM only
        row.remove();
        reNumberRows();
        // If table is empty restore the default blank row
        if ($('#tblBody tr').length === 0) addDefaultRow();
        return;
        }

        Swal.fire({
        title: 'Are you sure?',
        text: 'This record will be permanently deleted.',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonText: 'Yes, delete it',
        cancelButtonText: 'Cancel'
        }).then((confirmed) => {
        if (confirmed.isConfirmed) {
        $.ajax({
        url: `?handler=DeleteState&id=${id}`,
        type: 'POST',
        headers: { 'RequestVerificationToken': antiForgeryToken },
        success: function(res) {
        if (res.success) {
        row.remove();
        reNumberRows();
        if ($('#tblBody tr').length === 0) addDefaultRow();
        Swal.fire('Deleted', res.message, 'success');
        } else {
        Swal.fire('Error', res.message, 'error');
        }
        },
        error: function() {
        Swal.fire('Error', 'Failed to delete the record.', 'error');
        }
        });
        }
        });
        });

        // ════════════════════════════════════════════════════════════════════════
        // HELPER FUNCTIONS
        // ════════════════════════════════════════════════════════════════════════

        // Append a row that already exists in the DB
        function appendRow(id, code, description) {
        const serial = $('#tblBody tr').length + 1;
        const row = `
        <tr data-id="${id}">
         <td style="padding:10px; border:1px solid lightgrey; width:20px;">${serial}</td>
        <td style="text-align:left;padding:10px;border:1px solid lightgrey;"><input type="text" class="form-control border-primary col-code" value="${escapeHtml(code)}"></td>
        <td style="text-align:left;padding:10px;border:1px solid lightgrey;"><input type="text" class="form-control border-primary col-desc" value="${escapeHtml(description)}"></td>
        <td style="text-align:left;padding:10px;border:1px solid lightgrey;">
        <button type="button" class="btn btn-danger btn-delete-row" title="Delete">
        <i class="fas fa-trash"></i>Delete
        </button>
        </td>
        </tr>`;
        $('#tblBody').append(row);
        }

        // Append a blank row for new entry
        function addNewRow() {
        const serial = $('#tblBody tr').length + 1;
        const row = `
        <tr data-id="0">
        <td style="padding:10px; border:1px solid lightgrey; width:20px;">${serial}</td>
        <td style="text-align:left;padding:10px;border:1px solid lightgrey;"><input type="text" class="form-control border-primary col-code" placeholder="Code"></td>
        <td style="text-align:left;padding:10px;border:1px solid lightgrey;"><input type="text" class="form-control border-primary col-desc" placeholder="Description"></td>
        <td style="text-align:left;padding:10px;border:1px solid lightgrey;">
        <button type="button" class="btn btn-danger btn-delete-row" title="Delete">
        <i class="fas fa-trash"></i>Delete
        </button>
        </td>
        </tr>`;
        $('#tblBody').append(row);
        }

        // The default single blank row shown on page load and when table is empty
        function addDefaultRow() {
        $('#tblBody').empty();
        const row = `
        <tr data-id="0">
        <td style="padding:10px; border:1px solid lightgrey; width:20px;">1</td>
        <td style="text-align:left;padding:10px;border:1px solid lightgrey;"><input type="text" class="form-control border-primary col-code" placeholder="Code"></td>
        <td style="text-align:left;padding:10px;border:1px solid lightgrey;"><input type="text" class="form-control border-primary col-desc" placeholder="Description"></td>
        <td style="text-align:left;padding:10px;border:1px solid lightgrey;">
        <button type="button" class="btn btn-danger btn-delete-row" title="Delete">
        <i class="fas fa-trash"></i>Delete
        </button>
        </td>
        </tr>`;
        $('#tblBody').append(row);
        }

        // Reload all rows from DB after a successful save
        function reloadRows(stateId) {
        clearTable();
        $.ajax({
        url: `?handler=StateRows&stateId=${stateId}`,
        type: 'GET',
        success: function(data) {
        if (data.length === 0) {
        addDefaultRow();
        } else {
        $.each(data, function(i, row) {
        appendRow(row.id, row.code, row.description);
        });
        addNewRow();
        }
        },
        error: function () {
            Swal.fire('Error', 'Failed to load state records.', 'error');
        }
        });
        }

        // Wipe the table body
        function clearTable() {
        $('#tblBody').empty();
        }

        // Re-number S/N column after a row is deleted
        function reNumberRows() {
        $('#tblBody tr').each(function(index) {
        $(this).find('td:first').text(index + 1);
        });
        }

        // Reset state dropdown back to default disabled state
        function resetStateDropdown() {
        const ddl = $('#ddlState');
        ddl.find('option:not(:first)').remove();
        ddl.val('').prop('disabled', true).trigger('change.select2');
        }

        // Enable/disable Add Row and Save buttons
        function toggleButtons(enabled) {
        $('#btnAddRow, #btnSave').prop('disabled', !enabled);
        }

        // Escape HTML to prevent XSS when rendering saved values into inputs
        function escapeHtml(str) {
        if (!str) return '';
        return str
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
        }

        })();
    </script>
}
