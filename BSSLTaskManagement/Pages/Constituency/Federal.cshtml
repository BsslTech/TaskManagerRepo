@page
@model BSSLTaskManagement.Pages.Constituency.FederalModel
@{
    ViewData["Title"] = "Federal Constituency Setup";
}
@section Styles {
    @* {{-- Select2 CSS for searchable dropdowns --}} *@
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" />
}
<form method="post">
    <main class="app-main">

        <div class="app-content-header mb-2" style="padding:10px;">
            <div class="container-fluid">
                <div class="row">
                    <div class="col-sm-6">
                        <h3 class="mb-0">Federal Constituency Setup</h3>
                    </div>
                    <div class="col-sm-6">
                        <ol class="breadcrumb float-sm-end">
                            <li class="breadcrumb-item" style="padding:5px;"><a href="#">Home</a></li>
                            <li class="breadcrumb-item active" aria-current="page" style="padding:5px;">Federal Constituency Setup</li>
                        </ol>
                    </div>
                </div>
            </div>
        </div>

        <div class="card card-primary card-outline mb-4">
            <div class="app-content">
                <div class="container-fluid">
                    <div class="row">
                        <div class="col-md-12">
                            <div class="card-body">
                                <h6 class="spn font-italic"></h6>
                                <div class="row">
                                    <div class="col-6">
                                        <label for="ddlCountry" class="form-label req">Country</label>
                                        <select class="form-control form-select border-primary" id="ddlCountry" style="width:100%">
                                            <option value="">--Select Country--</option>
                                        </select>
                                    </div>
                                    <div class="col-6">
                                        <label for="ddlState" class="form-label req">State</label>
                                        <select class="form-control form-select border-primary" id="ddlState" style="width:100%" disabled>
                                            <option value="">--Select State--</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="mt-3" style="margin-bottom:1%">
                                    <button type="button" class="btn btn-success btnSave" disabled>
                                        <i class="fas fa-save"></i> Save
                                    </button>
                                    <a href="./Federal" class="btn btn-warning">Refresh</a>
                                    <button type="button" class="btn btn-primary btnAddRow" disabled>
                                        <i class="fas fa-plus"></i> Add Row
                                    </button>
                                </div>

                                <table style="width:100%" class="table table-bordered display nowrap" id="tblFederal">
                                    <thead>
                                        <tr>
                                            <th style="text-align:center;padding:10px;border:1px solid lightgrey;text-transform:none;width:20px">S/N</th>
                                            <th style="text-align:center;padding:10px;border:1px solid lightgrey;text-transform:none;width:150px">Code</th>
                                            <th style="text-align:center;padding:10px;border:1px solid lightgrey;text-transform:none;">Description</th>
                                            <th style="text-align:center;padding:10px;border:1px solid lightgrey;text-transform:none;width:80px">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody id="tblBody">
                                        @* Default empty row visible on page load *@
                                        <tr data-id="0">
                                            <td style="padding:10px; border:1px solid lightgrey; width:20px;">1</td>
                                            <td style="text-align:left;padding:10px;border:1px solid lightgrey;"><input type="text" class="form-control border-primary col-code" placeholder="Code"></td>
                                            <td style="text-align:left;padding:10px;border:1px solid lightgrey;"><input type="text" class="form-control border-primary col-desc" placeholder="Description"></td>
                                            <td style="text-align:center;padding:10px;border:1px solid lightgrey;">
                                                <button type="button" class="btn btn-danger btn-delete-row" title="Delete">
                                                    <i class="fas fa-trash"></i> Delete
                                                </button>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>

                                <div class="mt-3" style="margin-bottom:2%">
                                    <button type="button" class="btn btn-success btnSave" disabled>
                                        <i class="fas fa-save"></i> Save
                                    </button>
                                    <a href="./Federal" class="btn btn-warning">Refresh</a>
                                    <button type="button" class="btn btn-primary btnAddRow" disabled>
                                        <i class="fas fa-plus"></i> Add Row
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>
</form>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>
        (function () {

        // ── State tracking ───────────────────────────────────────────────────────
        let selectedStateId = 0;

        // ── Antiforgery token ────────────────────────────────────────────────────
        const antiForgeryToken = $('input[name="__RequestVerificationToken"]').val();

        // ════════════════════════════════════════════════════════════════════════
        // INITIALIZE Select2
        // ════════════════════════════════════════════════════════════════════════
        $('#ddlCountry').select2({ theme: 'bootstrap-5', placeholder: '--Select Country--', allowClear: true, width: '100%' });
        $('#ddlState').select2({   theme: 'bootstrap-5', placeholder: '--Select State--',   allowClear: true, width: '100%' });

        // ════════════════════════════════════════════════════════════════════════
        // PAGE LOAD: Populate Country dropdown
        // ════════════════════════════════════════════════════════════════════════
        loadCountries();

        function loadCountries() {
        $.ajax({
        url: '?handler=Countries',
        type: 'GET',
        success: function (data) {
        const ddl = $('#ddlCountry');
        ddl.find('option:not(:first)').remove();
        $.each(data, function (i, item) {
        ddl.append(`<option value="${item.id}">${item.description}</option>`);
        });
        ddl.trigger('change.select2');
        },
        error: function () {
        Swal.fire('Error', 'Failed to load countries.', 'error');
        }
        });
        }

        // ════════════════════════════════════════════════════════════════════════
        // COUNTRY CHANGE: Load matching states
        // ════════════════════════════════════════════════════════════════════════
        $('#ddlCountry').on('change', function () {
        const countryId = $(this).val();
        resetStateDropdown();
        clearTable();
        addDefaultRow();
        selectedStateId = 0;
        toggleButtons(false);
        if (!countryId) return;

        $.ajax({
        url: `?handler=StatesByCountry&countryId=${countryId}`,
        type: 'GET',
        success: function (data) {
        const ddl = $('#ddlState');
        ddl.find('option:not(:first)').remove();
        if (data.length === 0) {
        Swal.fire('Info', 'No states found for the selected country.', 'info');
        ddl.trigger('change.select2');
        return;
        }
        $.each(data, function (i, item) {
        ddl.append(`<option value="${item.id}">${item.description}</option>`);
        });
        ddl.prop('disabled', false).trigger('change.select2');
        },
        error: function () {
        Swal.fire('Error', 'Failed to load states.', 'error');
        }
        });
        });

        // ════════════════════════════════════════════════════════════════════════
        // STATE CHANGE: Load existing federal constituency rows
        // ════════════════════════════════════════════════════════════════════════
        $('#ddlState').on('change', function () {
        const stateId = parseInt($(this).val());
        selectedStateId = stateId;
        clearTable();

        if (!stateId) {
        toggleButtons(false);
        addDefaultRow();
        return;
        }

        toggleButtons(true);

        $.ajax({
        url: `?handler=FederalRows&stateId=${stateId}`,
        type: 'GET',
        success: function (data) {
        if (data.length === 0) {
        addDefaultRow();
        } else {
        $.each(data, function (i, row) {
        appendRow(row.id, row.code, row.description);
        });
        addNewRow();
        }
        },
        error: function () {
        Swal.fire('Error', 'Failed to load federal constituency records.', 'error');
        }
        });
        });

        // ════════════════════════════════════════════════════════════════════════
        // ADD ROW BUTTON
        // ════════════════════════════════════════════════════════════════════════
        $('.btnAddRow').on('click', function () {
        if (selectedStateId <= 0) {
        Swal.fire('Warning', 'Please select a state first.', 'warning');
        return;
        }
        addNewRow();
        });

        // ════════════════════════════════════════════════════════════════════════
        // DUPLICATE CODE CHECK
        // ── blur: checks a single code input against the DB for the current state
        // ── checkAllCodesUnique: checks across all rows in the table before save
        // ════════════════════════════════════════════════════════════════════════

        // Blur — fires when user leaves a Code cell
        $('#tblBody').on('blur', '.col-code', async function () {
        const input = $(this);
        const code  = input.val().trim();
        const rowId = parseInt(input.closest('tr').data('id') || 0);

        if (!code || selectedStateId <= 0) return;

        try {
        const result = await $.get(`?handler=CheckDuplicateCode&stateId=${selectedStateId}&code=${encodeURIComponent(code)}&excludeId=${rowId}`);
        if (result.codeTaken) {
        setCodeError(input, 'This code is already used in this state.');
        } else {
        clearCodeError(input);
        }
        } catch {
        // Silent — save-time check will catch it
        }
        });

        // Pre-save: check all codes in the table are unique among themselves
        // (catches duplicates the user typed into two rows before either lost focus)
        function checkAllCodesUnique() {
        const seen  = {};
        let conflict = null;

        $('#tblBody tr').each(function () {
        const input = $(this).find('.col-code');
        const code  = input.val().trim().toLowerCase();
        if (!code) return; // skip empty rows

        if (seen[code]) {
        conflict = input.val().trim();
        return false; // break
        }
        seen[code] = true;
        });

        return conflict; // null = all unique, otherwise the duplicate code string
        }

        // ════════════════════════════════════════════════════════════════════════
        // SAVE BUTTON
        // ════════════════════════════════════════════════════════════════════════
        $('.btnSave').on('click', async function () {
        if (selectedStateId <= 0) {
        Swal.fire('Warning', 'Please select a state first.', 'warning');
        return;
        }

        // ── 1. Check for duplicate codes within the table rows ────────────
        const dupCode = checkAllCodesUnique();
        if (dupCode) {
        Swal.fire({
        icon: 'error',
        title: 'Duplicate Code',
        text: `The code "${dupCode}" appears more than once. Each code must be unique within the state.`,
        confirmButtonColor: '#dc3545'
        });
        return;
        }

        // ── 2. Check for any inline code errors still showing ─────────────
        if ($('#tblBody .col-code.is-invalid').length > 0) {
        Swal.fire({
        icon: 'error',
        title: 'Duplicate Codes Found',
        text: 'One or more codes are already in use for this state. Please fix them before saving.',
        confirmButtonColor: '#dc3545'
        });
        return;
        }

        // ── 3. Collect and validate rows ──────────────────────────────────
        const rows = [];
        let hasError = false;

        $('#tblBody tr').each(function () {
        const id   = parseInt($(this).data('id') || 0);
        const code = $(this).find('.col-code').val().trim();
        const desc = $(this).find('.col-desc').val().trim();

        if (!code && !desc) return; // skip blank rows

        if (!code || !desc) {
        hasError = true;
        return false; // break
        }

        rows.push({ id, code, description: desc });
        });

        if (hasError) {
        Swal.fire('Validation', 'Each row must have both a Code and a Description.', 'warning');
        return;
        }

        if (rows.length === 0) {
        Swal.fire('Validation', 'No rows to save.', 'warning');
        return;
        }

        // ── 4. Confirm then POST ──────────────────────────────────────────
        const confirm = await Swal.fire({
        title: 'Save Records?',
        text: `Save ${rows.length} federal constituency record(s)?`,
        icon: 'question',
        showCancelButton: true,
        confirmButtonColor: '#198754',
        cancelButtonColor: '#6c757d',
        confirmButtonText: 'Yes, Save'
        });

        if (!confirm.isConfirmed) return;

        Swal.fire({ title: 'Saving...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });

        $.ajax({
        url: '?handler=SaveFederal',
        type: 'POST',
        contentType: 'application/json',
        headers: { 'RequestVerificationToken': antiForgeryToken },
        data: JSON.stringify({ stateId: selectedStateId, rows }),
        success: function (result) {
        if (result.success) {
        Swal.fire('Success', result.message, 'success').then(() => {
        reloadRows(selectedStateId);
        });
        } else {
        Swal.fire('Error', result.message, 'error');
        }
        },
        error: function () {
        Swal.fire('Error', 'An unexpected error occurred while saving.', 'error');
        }
        });
        });

        // ════════════════════════════════════════════════════════════════════════
        // DELETE ROW
        // ════════════════════════════════════════════════════════════════════════
        $('#tblBody').on('click', '.btn-delete-row', function () {
        const row = $(this).closest('tr');
        const id  = parseInt(row.data('id') || 0);

        if (id === 0) {
        row.remove();
        reNumberRows();
        if ($('#tblBody tr').length === 0) addDefaultRow();
        return;
        }

        Swal.fire({
        title: 'Are you sure?',
        text: 'This record will be permanently deleted.',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonText: 'Yes, delete it',
        cancelButtonText: 'Cancel'
        }).then((confirmed) => {
        if (confirmed.isConfirmed) {
        $.ajax({
        url: `?handler=DeleteFederal&id=${id}`,
        type: 'POST',
        headers: { 'RequestVerificationToken': antiForgeryToken },
        success: function (res) {
        if (res.success) {
        row.remove();
        reNumberRows();
        if ($('#tblBody tr').length === 0) addDefaultRow();
        Swal.fire('Deleted', res.message, 'success');
        } else {
        Swal.fire('Error', res.message, 'error');
        }
        },
        error: function () {
        Swal.fire('Error', 'Failed to delete the record.', 'error');
        }
        });
        }
        });
        });

        // ════════════════════════════════════════════════════════════════════════
        // INLINE ERROR HELPERS
        // ════════════════════════════════════════════════════════════════════════

        function setCodeError(inputEl, message) {
        inputEl.addClass('is-invalid').removeClass('is-valid');
        let fb = inputEl.next('.invalid-feedback');
        if (fb.length === 0) {
        fb = $(`<div class="invalid-feedback"></div>`);
        inputEl.after(fb);
        }
        fb.text(message);
        }

        function clearCodeError(inputEl) {
        inputEl.removeClass('is-invalid');
        inputEl.next('.invalid-feedback').remove();
        }

        // ════════════════════════════════════════════════════════════════════════
        // HELPER FUNCTIONS
        // ════════════════════════════════════════════════════════════════════════

        function appendRow(id, code, description) {
        const serial = $('#tblBody tr').length + 1;
        $('#tblBody').append(`
        <tr data-id="${id}">
        <td style="padding:10px; border:1px solid lightgrey; width:20px;">${serial}</td>
        <td style="text-align:left;padding:10px;border:1px solid lightgrey;"><input type="text" class="form-control border-primary col-code" value="${escapeHtml(code)}"></td>
        <td style="text-align:left;padding:10px;border:1px solid lightgrey;"><input type="text" class="form-control border-primary col-desc" value="${escapeHtml(description)}"></td>
        <td style="text-align:left;padding:10px;border:1px solid lightgrey;">
        <button type="button" class="btn btn-danger btn-delete-row" title="Delete"><i class="fas fa-trash"></i> Delete</button>
        </td>
        </tr>`);
        }

        function addNewRow() {
        const serial = $('#tblBody tr').length + 1;
        $('#tblBody').append(`
        <tr data-id="0">
        <td style="padding:10px; border:1px solid lightgrey; width:20px;">${serial}</td>
        <td style="text-align:left;padding:10px;border:1px solid lightgrey;"><input type="text" class="form-control border-primary col-code" placeholder="Code"></td>
        <td style="text-align:left;padding:10px;border:1px solid lightgrey;"><input type="text" class="form-control border-primary col-desc" placeholder="Description"></td>
        <td style="text-align:left;padding:10px;border:1px solid lightgrey;">
        <button type="button" class="btn btn-danger btn-delete-row" title="Delete"><i class="fas fa-trash"></i> Delete</button>
        </td>
        </tr>`);
        }

        function addDefaultRow() {
        $('#tblBody').empty();
        $('#tblBody').append(`
        <tr data-id="0">
        <td style="padding:10px; border:1px solid lightgrey; width:20px;">1</td>
        <td style="text-align:left;padding:10px;border:1px solid lightgrey;"><input type="text" class="form-control border-primary col-code" placeholder="Code"></td>
        <td style="text-align:left;padding:10px;border:1px solid lightgrey;"><input type="text" class="form-control border-primary col-desc" placeholder="Description"></td>
        <td style="text-align:left;padding:10px;border:1px solid lightgrey;">
        <button type="button" class="btn btn-danger btn-delete-row" title="Delete"><i class="fas fa-trash"></i> Delete</button>
        </td>
        </tr>`);
        }

        function reloadRows(stateId) {
        clearTable();
        $.ajax({
        url: `?handler=FederalRows&stateId=${stateId}`,
        type: 'GET',
        success: function (data) {
        if (data.length === 0) {
        addDefaultRow();
        } else {
        $.each(data, function (i, row) {
        appendRow(row.id, row.code, row.description);
        });
        addNewRow();
        }
        }
        });
        }

        function clearTable()    { $('#tblBody').empty(); }

        function reNumberRows() {
        $('#tblBody tr').each(function (index) {
        $(this).find('td:first').text(index + 1);
        });
        }

        function resetStateDropdown() {
        const ddl = $('#ddlState');
        ddl.find('option:not(:first)').remove();
        ddl.val('').prop('disabled', true).trigger('change.select2');
        }

        function toggleButtons(enabled) {
        $('.btnAddRow, .btnSave').prop('disabled', !enabled);
        }

        function escapeHtml(str) {
        if (!str) return '';
        return str
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
        }

        })();
    </script>
}
