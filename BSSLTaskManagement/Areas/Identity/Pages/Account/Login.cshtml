@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
    Layout = "_Login";
}
<head>
    <!-- Basic Page Info -->
    <meta charset="utf-8">
    <title>BSSL Task Manager</title>

    <link rel="icon"
          type="image/png"
          sizes="16x16"
          href="/dashboard/assets/images/images.jpg" />
    <!-- Mobile Specific Metas -->
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">

    <!-- Google Font -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- CSS -->
    <link rel="stylesheet" type="text/css" href="/file/vendors/styles/core.css">
    <link rel="stylesheet" type="text/css" href="/file/vendors/styles/icon-font.min.css">
    <link rel="stylesheet" type="text/css" href="/file/vendors/styles/style.css">

    <!-- Global site tag (gtag.js) - Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=UA-119386393-1"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag('js', new Date());

        gtag('config', 'UA-119386393-1');
    </script>
    <style>
        /* On small screens make the login box overlay the image and stay on top */
        @@media (max-width: 767.98px) {
            .login-wrap .container { position: relative; }
            .login-wrap .login-box {
                position: absolute;
                top: 10px;
                left: 10px;
                right: 10px;
                z-index: 20;
                background: rgba(255,255,255,0.98);
                box-shadow: 0 6px 18px rgba(0,0,0,0.1);
            }
            /* slightly dim the image behind when overlaid */
            .login-wrap img { opacity: 0.4; }
        }
    </style>
</head>
<body class="login-page">
    <div class="login-wrap d-flex align-items-center flex-wrap justify-content-center">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-6 col-lg-7 order-2 order-md-1">
                    <img src="/file/vendors/images/login-page-img.png" alt="">
                </div>
                <div class="col-md-6 col-lg-5 order-1 order-md-2">
                    <div class="login-box bg-white box-shadow border-radius-10">
                        <div class="login-title">
                            <h2 class="text-center text-primary">Login To BSSL Task Manager</h2>
                        </div>
                        <form method="post">
                            @if (Model.ModelState.ErrorCount > 0)
                            {
                                <div asp-validation-summary="All" class="alert alert-danger aspValidation"
                                     role="alert">
                                </div>
                            }
                            <div class="input-group custom">
                                <input type="text" asp-for="Input.Email" class="form-control form-control-lg" placeholder="Username">
                                @*<span class="input-group-text" asp-validation-for="LoginVM.Email"></span>*@
                                <div class="input-group-append custom">
                                    <span class="input-group-text"><i class="icon-copy dw dw-user1"></i></span>
                                </div>
                            </div>
                            <div class="input-group custom">
                                <input type="password" asp-for="Input.Password" class="form-control form-control-lg" placeholder="**********">
                                @*<span class="input-group-text" asp-validation-for="LoginVM.Password"></span>*@
                                <div class="input-group-append custom">
                                    <span class="input-group-text"><i class="dw dw-padlock1"></i></span>
                                </div>
                            </div>
                            <div class="row pb-30">
                                <div class="col-6">
                                    <div class="custom-control custom-checkbox">
                                        <input type="checkbox" class="custom-control-input" id="customCheck1">
                                        <label class="custom-control-label" for="customCheck1">Remember</label>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="forgot-password"><a href="./ForgotPassword">Forgot Password</a></div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-sm-12">
                                    <div class="input-group mb-0">
                                        <!--
                                            use code for form submit
                                            <input class="btn btn-primary btn-lg btn-block" type="submit" value="Sign In">
                                        -->
                                        <button class="btn btn-primary btn-lg btn-block" type="submit">Sign In</button>
                                    </div>
                                    <div class="font-16 weight-600 pt-10 pb-10 text-center" data-color="#707373">OR</div>
                                    <div class="input-group mb-0">
                                        <a class="btn btn-outline-primary btn-lg btn-block" href="/Identity/Account/Register">Create Account</a>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- js -->
    <script src="/file/vendors/scripts/core.js"></script>
    <script src="/file/vendors/scripts/script.min.js"></script>
    <script src="/file/vendors/scripts/process.js"></script>
    <script src="/file/vendors/scripts/layout-settings.js"></script>
</body>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
